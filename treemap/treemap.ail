## treemap: squarified treemap layout (Bruls, Huizing, van Wijk). Pure: sizes
## in, rectangles out, so it is tested without a window.

pub struct Box
    pub x float
    pub y float
    pub w float
    pub h float

## The worst aspect ratio of a row of areas `a` (sorted large to small) laid
## along a side of length `side`.
fn worst(sum float, big float, small float, side float) float
    s2 := side * side
    (s2 * big / (sum * sum)).max(sum * sum / (s2 * small))

## Lays out `sizes` (largest first, all above zero) in the rectangle; the
## result has one box per size, in the same order. The areas add up to the
## rectangle's.
pub fn layout(sizes List[int], x float, y float, w float, h float) List[Box]
    n := sizes.len()
    mut out := []
    if n == 0
        return out
    mut total := 0.0
    for s in sizes
        total += s.to_float()
    scale := w * h / total
    areas := [s.to_float() * scale for s in sizes]
    mut cx := x
    mut cy := y
    mut cw := w
    mut ch := h
    mut i := 0
    while i < n
        side := cw.min(ch)
        mut j := i
        mut sum := 0.0
        mut best := 1.0e18
        while j < n
            a := areas[j]
            r := worst(sum + a, areas[i], a, side)
            if j > i and r > best
                break
            best = r
            sum += a
            j += 1
        # Lay the row i..j along the short side.
        thick := sum / side.max(0.001)
        mut off := 0.0
        for k in i..j
            ln := areas[k] / thick.max(0.001)
            if cw >= ch
                out.push(Box(x: cx, y: cy + off, w: thick, h: ln))
            else
                out.push(Box(x: cx + off, y: cy, w: ln, h: thick))
            off += ln
        if cw >= ch
            cx += thick
            cw -= thick
        else
            cy += thick
            ch -= thick
        i = j
    out

@test fn fills_the_rectangle()
    boxes := layout([60, 30, 6, 4], 0.0, 0.0, 100.0, 50.0)
    assert_eq(boxes.len(), 4)
    mut area := 0.0
    for b in boxes
        area += b.w * b.h
    assert((area - 5000.0).abs() < 0.01)
    assert((boxes[0].w * boxes[0].h - 3000.0).abs() < 0.01)

@test fn empty_is_empty()
    assert_eq(layout([], 0.0, 0.0, 10.0, 10.0).len(), 0)
