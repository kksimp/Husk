## Husk's window: finds what is using your disk and says what is safe to delete.
## This file is the std.app shell: it owns the `State` (view/view.ail) and turns
## events into changes. Run on macOS from the ail checkout:
##   tools/app-host/macos/run.sh path/to/husk/husk_gui.ail [FOLDER]
## FOLDER defaults to your home folder. The scan runs in a task, so the window
## opens at once with a progress bar and fills in when the scan is done.

use std.app
use mock
use view
use bridge
use scan

struct Husk
    s view.State
    ## Where the scan task leaves the finished tree.
    done Channel[mock.Model]

impl app.App for Husk
    fn update(mut self, ev app.Event)
        match ev.kind
            "resize" if ev.id == "main" =>
                s.w = ev.dx
                s.h = ev.dy
                s.top = s.top.min(view.max_scroll(s))
            "scroll" =>
                s.top = (s.top + ev.dy).max(0.0).min(view.max_scroll(s))
            "click" if ev.id == "main" and ev.text == "left" => click(ev.x, ev.y)
            "key" => key(ev.text)
            "external" if ev.id == "scan" => progress(ev.text)
            "external" if ev.id == "scan_done" => finished()
            "external" if ev.id == "scan_failed" => failed(ev.text)
            _ => return

    fn view(self) app.Node
        f := view.draw(s)
        app.canvas("main", 0.0, 0.0, f.ops)

    fn title(self) str
        "Husk"

## A scan update from the scanner: `pct|files|path`.
fn Husk.progress(mut self, text str)
    parts := text.split("|")
    if parts.len() < 3
        return
    s.pct = (parts[0].to_float() else 1.0).max(0.0).min(1.0)
    s.scan_note = "{parts[1]} files · {parts[2]}"

## The scan task is done: take its tree.
fn Husk.finished(mut self)
    m := done.recv() else return
    s.m = m
    s.gone = {}
    s.marks = {}
    s.eff = mock.sizes(m, s.gone)
    s.cur = 0
    s.sel = -1
    s.pct = 1.0
    s.scan_note = ""
    s.notice = ""

fn Husk.failed(mut self, text str)
    s.pct = 1.0
    s.notice = "Scan failed: {text}"

fn Husk.go(mut self, id int)
    s.cur = id
    s.filter = ""
    s.sel = -1
    s.top = 0.0

fn Husk.click(mut self, x float, y float)
    f := view.draw(s)
    r := view.hit(f, x, y) else return
    match r.kind
        "nav" =>
            s.filter = r.arg
            s.cur = 0
            s.sel = -1
            s.top = 0.0
        "crumb" => go(r.k)
        "tile" | "row" =>
            if s.sel == r.k and s.m.entries[r.k].is_dir and not s.m.entries[r.k].kids.is_empty()
                go(r.k)
            else
                s.sel = r.k
        "check" =>
            if not s.marks.add(r.k)
                s.marks.remove(r.k)
            s.sel = r.k
            s.undo = []
        "sort" =>
            if s.sort_key == r.arg
                s.desc = not s.desc
            else
                s.sort_key = r.arg
                s.desc = r.arg != "name"
            s.top = 0.0
        "all_safe" =>
            for id in mock.rows(s.m, 0, "safe", s.eff)
                s.marks.add(id)
            s.undo = []
        "review" =>
            if not s.marks.is_empty()
                s.sheet = true
        "cancel" => s.sheet = false
        "trash" => trash()
        "undo" => undo()
        _ => return

## Moves the marked entries to the Trash with `fs.trash` (ADR 0929). A real entry that fails stays; the footer says why.
## Mock entries (no path) are only hidden, and Undo shows them again.
fn Husk.trash(mut self)
    ids := mock.top_marks(s.m, s.marks)
    mut moved := List[int]()
    mut why := ""
    mut real := false
    for id in ids
        p := s.m.entries[id].path
        if p != ""
            real = true
            fs.trash(p) else err
                why = "{err}"
                continue
        s.gone.add(id)
        moved.push(id)
    s.undo = List[int]()
    s.notice = why
    if not real
        s.undo = moved
    elif why == ""
        s.notice = "Moved {moved.len()} items to the Trash. Use Put Back in Finder to restore them."
    s.marks = {}
    s.sheet = false
    s.sel = -1
    s.eff = mock.sizes(s.m, s.gone)
    if s.eff[s.cur] <= 0
        s.cur = 0

fn Husk.undo(mut self)
    for id in s.undo
        s.gone.remove(id)
    s.undo = []
    s.eff = mock.sizes(s.m, s.gone)

fn Husk.key(mut self, name str)
    k := name.to_lower()
    if k == "escape"
        s.sheet = false
    elif k == "backspace" and s.filter == "" and s.cur > 0
        go(s.m.entries[s.cur].parent)

fn fresh() Husk
    Husk(s: view.State.new(mock.mock()), done: Channel[mock.Model](1))

## A one-folder tree to show while the scan runs.
fn placeholder(root str) mock.Model
    mut m := mock.Model(entries: [], vol_total: 0, vol_used: 0)
    mock.add(mut m, -1, root, 1, true, "keep", "Scanning…", "", "")
    m

## The scan task: scan `root`, hand the tree over, tell the window.
fn scanner(inbox app.Inbox, done Channel[mock.Model], root str)
    inbox.post(app.external("scan", "0.0|0|{root}"))
    s := scan.scan(root) else err
        inbox.post(app.external("scan_failed", "{err}"))
        return
    floor := (s.total / 3000).max(1048576).min(67108864)
    mut tree := bridge.tree(s, env.home() else "/", time.now_ms(), floor)
    v := fs.volume(root) else err
        tree.vol_total = 0
        done.send(tree)
        inbox.post(app.external("scan_done", ""))
        return
    tree.vol_total = v.total
    tree.vol_used = v.total - v.free
    done.send(tree)
    inbox.post(app.external("scan_done", ""))

fn main()
    root := env.args().get(0) else (env.home() else "/")
    done := Channel[mock.Model](1)
    mut h := Husk(s: view.State.new(placeholder(root)), done: done)
    h.s.pct = 0.02
    h.s.scan_note = root
    inbox := app.new_inbox()
    g := TaskGroup()
    g.add(spawn scanner(inbox, done, root))
    host := app.host_path() else err
        print("no window: {err.kind}: {err.message}")
        return
    app.run_with(mut h, host, [], inbox) else err
        print("no window: {err.kind}: {err.message}")

@test fn starts_on_the_overview()
    mut h := fresh()
    screens := app.script(mut h, [app.event("start")])
    assert(screens[0].contains("canvas #main"))
    assert_eq(h.s.cur, 0)

@test fn ticking_and_trashing_frees_space()
    mut h := fresh()
    before := h.s.eff[0]
    h.s.filter = "safe"
    for id in mock.rows(h.s.m, 0, "safe", h.s.eff)
        h.s.marks.add(id)
    freed := h.s.reclaim()
    assert(freed > 0)
    h.trash()
    assert_eq(h.s.eff[0], before - freed)
    h.undo()
    assert_eq(h.s.eff[0], before)

@test fn scan_events_drive_progress()
    mut h := fresh()
    ev := app.external("scan", "0.25|1200|/Users/kaleb")
    h.update(ev)
    assert(h.s.pct < 0.3)
    assert(h.s.scan_note.contains("1200 files"))

@test fn overview_has_regions()
    h := fresh()
    f := view.draw(h.s)
    assert(f.regs.len() > 10)
