## Husk's window: finds what is using your disk and says what is safe to delete.
## This file is the std.app shell: it owns the `State` (state/state.ail) and turns
## events into changes. Run on macOS from the ail checkout:
##   tools/app-host/macos/run.sh path/to/husk/husk.ail gui [FOLDER]
## The window opens on a welcome page: pick Smart scan, a folder button, or type a
## folder in the field and press Return. With a FOLDER argument it scans that at
## once. The scan runs in a task, so the window stays responsive.

use std.app
use std.log
use mock
use state
use side
use view
use bridge
use scan
use sysops

## What to scan: the roots, and the name of the top entry of the result.
struct Req
    roots List[str]
    label str

struct Husk
    s state.State
    ## Where the scan task leaves the finished tree.
    done Channel[mock.Model]
    ## Scan requests for the scan task.
    reqs Channel[Req]
    ## The target id of the last scan, for Rescan.
    last str
    ## A folder dialog is open (std.app.21).
    picking bool
    ## The frame last drawn: clicks and pointer moves are looked up in it.
    f state.Frame
    ## The right-click menu while it is open (std.app.18) and the entry it is for.
    menu app.Popup?
    menu_for int
    ## Lines for the host, such as the clipboard (std.app.21, std.app.26).
    out List[str]

impl app.App for Husk
    fn update(mut self, ev app.Event)
        if ev.kind == app.EventKind.Move or ev.kind == app.EventKind.Leave
            if not self.pointer(ev)
                return
        else
            self.handle(ev)
        self.f = view.draw(self.s)

    fn view(self) app.Node
        app.column([
            app.row([
                app.field("path", self.s.path, "Folder to scan, such as ~/Library (~ is your home)"),
                app.button("go", "Scan"),
                app.field("find", self.s.find, "Search names"),
            ]),
            app.canvas("main", 0.0, 0.0, self.f.ops),
        ])

    fn title(self) str
        "Husk"

    fn hover(self) bool
        self.s.scanned

    fn popup(self) app.Popup?
        self.menu

    fn lines(mut self) List[str]
        sent := self.out
        self.out = []
        sent

    fn pick(self) app.Picker?
        if self.picking
            return app.Picker(
                id: "folder",
                prompt: "Choose a folder to scan",
                folders: true,
                start: home(),
            )
        none

    fn focus(self) str
        if self.s.scanned
            return ""
        "path"

## One event other than a pointer move. Kinds it does not use fall to `_`.
@allow("expr.match.3") fn Husk.handle(mut self, ev app.Event)
    match ev.kind
        app.EventKind.Resize if ev.id == "main" =>
            self.s.w = ev.dx
            self.s.h = ev.dy
            self.s.top = self.s.top.min(view.max_scroll(self.s))
            self.s.side_top = self.s.side_top.min(side.side_max(self.s))
        app.EventKind.Scroll if self.s.mx < state.SIDE_W =>
            self.s.side_top = (self.s.side_top + ev.dy).max(0.0).min(side.side_max(self.s))
        app.EventKind.Scroll =>
            self.s.top = (self.s.top + ev.dy).max(0.0).min(view.max_scroll(self.s))
        app.EventKind.Click if ev.id == "main" and ev.text == "left" => self.click(
            ev.x,
            ev.y,
            ev.clicks,
        )
        app.EventKind.Click if ev.id == "main" and ev.text == "right" => self.context(ev.x, ev.y)
        app.EventKind.Popup =>
            self.menu = none
            self.act(ev.text)
        app.EventKind.Key => self.key(ev.text)
        app.EventKind.Edit if ev.id == "path" => self.s.path = ev.text
        app.EventKind.Edit if ev.id == "find" => self.search(ev.text)
        app.EventKind.Submit if ev.id == "path" => self.start(self.s.path)
        app.EventKind.Press if ev.id == "go" => self.start(self.s.path)
        app.EventKind.Picked =>
            self.picking = false
            if ev.text != ""
                self.s.path = ev.text
                self.start(ev.text)
        app.EventKind.PickError =>
            self.picking = false
            self.s.notice = "{ev.text}. Type the folder in the field instead."
        app.EventKind.External if ev.id == "scan" => self.progress(ev.text)
        app.EventKind.External if ev.id == "scan_done" => self.finished()
        app.EventKind.External if ev.id == "scan_failed" => self.failed(ev.text)
        _ => return

## A scan update from the scanner: `pct|files|path`.
fn Husk.progress(mut self, text str)
    parts := text.split("|")
    if parts.len() < 3
        return
    self.s.pct = (parts[0].to_float() else 1.0).max(0.0).min(1.0)
    self.s.scan_note = "{parts[1]} files · {parts[2]}"

## The scan task is done: take its tree.
fn Husk.finished(mut self)
    m := self.done.recv() else return
    self.s.m = m
    self.s.gone = {}
    self.s.marks = {}
    self.s.eff = mock.sizes(m, self.s.gone)
    self.s.cur = 0
    if m.entries[0].kids.len() == 1
        self.s.cur = m.entries[0].kids[0]
    self.s.filter = ""
    self.s.scanned = true
    self.s.top = 0.0
    self.s.sel = -1
    self.s.pct = 1.0
    self.s.scan_note = ""
    self.s.notice = ""

fn Husk.failed(mut self, text str)
    self.s.pct = 1.0
    self.s.notice = "Scan failed: {text}"

fn home() str
    env.home() else "/"

## The roots a target id stands for. Anything else is a folder path (`~` is home).
fn roots_of(id str) List[str]
    h := home()
    if id == "smart"
        return [h, "/Library", "/Applications"]
    if id == "home"
        return [h]
    if id == "dev"
        return ["{h}/Library/Developer"]
    if id == "library"
        return ["{h}/Library"]
    if id == "disk"
        return ["/Users", "/Library", "/Applications", "/opt", "/usr/local"]
    if id == "~"
        return [h]
    if id.starts_with("~/")
        return ["{h}/{id.slice(2, id.len())}"]
    [id]

fn targets() List[state.Target]
    [
        state.Target(
            id: "smart",
            label: "Smart scan",
            detail: "Home, /Library and Applications: caches, Xcode data, simulators, wallpapers, installers",
        ),
        state.Target(
            id: "choose",
            label: "Choose folder…",
            detail: "Pick any folder in the macOS dialog",
        ),
        state.Target(id: "home", label: "Home folder", detail: "Everything in your user folder"),
        state.Target(
            id: "dev",
            label: "Xcode and simulators",
            detail: "~/Library/Developer: DerivedData, device support, simulator devices",
        ),
        state.Target(
            id: "library",
            label: "Library",
            detail: "~/Library: app caches, logs, containers",
        ),
        state.Target(
            id: "disk",
            label: "Whole disk",
            detail: "Every user, /Library, Applications; not macOS system files",
        ),
    ]

## Asks the scan task to scan a target id or a folder path, unless a scan is running.
fn Husk.start(mut self, id str)
    t := id.trim()
    if t == "choose"
        self.picking = true
        return
    if t == "" or self.s.pct < 1.0
        return
    roots := roots_of(t)
    label := if roots.len() == 1 then roots[0] else "This Mac"
    self.s.pct = 0.02
    self.s.scan_note = roots.join(", ")
    self.s.notice = ""
    self.last = t
    self.reqs.send(Req(roots: roots, label: label))

fn Husk.go(mut self, id int)
    self.s.cur = id
    self.s.filter = ""
    self.s.sel = -1
    self.s.top = 0.0

## A pointer `move` or `leave`: true when the hovered tile or row changed, so the
## tooltip must be drawn again. The tooltip stays where the pointer entered.
fn Husk.pointer(mut self, ev app.Event) bool
    mut id := -1
    if ev.kind == app.EventKind.Move
        self.s.mx = ev.x
        if r := view.hit(self.f, ev.x, ev.y)
            if r.kind == "tile" or r.kind == "row"
                id = r.k
    if id == self.s.hover
        return false
    self.s.hover = id
    self.s.hx = ev.x
    self.s.hy = ev.y
    true

## The search field changed: show the entries whose names contain the text.
fn Husk.search(mut self, text str)
    self.s.find = text
    q := text.trim()
    self.s.filter = if q == "" then "" else "find:{q}"
    self.s.sel = -1
    self.s.top = 0.0

## A right-click on a tile or row selects it and opens its menu.
fn Husk.context(mut self, x float, y float)
    r := view.hit(self.f, x, y) else return
    if r.kind != "tile" and r.kind != "row" and r.kind != "check"
        return
    self.s.sel = r.k
    self.s.hover = -1
    self.menu_for = r.k
    self.menu = app.Popup(id: "item", x: x, y: y, items: self.menu_items(r.k))

## The right-click menu for entry `id`.
fn Husk.menu_items(self, id int) List[str]
    e := self.s.m.entries[id]
    mut items := [REVEAL, OPEN, COPY]
    if self.s.filter != ""
        items.push(SHOW)
    if e.is_dir and not e.kids.is_empty()
        items.push(INTO)
    items.push(if self.s.marks.contains(id) then UNMARK else MARK)
    items

REVEAL := "Reveal in Finder"
OPEN := "Open"
COPY := "Copy Path"
SHOW := "Show in Enclosing Folder"
INTO := "Look Inside"
MARK := "Tick for the Trash"
UNMARK := "Untick"

## A menu choice for the entry the menu was opened on; `""` is a dismissed menu.
fn Husk.act(mut self, label str)
    id := self.menu_for
    if id < 0 or id >= self.s.m.entries.len()
        return
    e := self.s.m.entries[id]
    if label == REVEAL
        self.finder(["-R", e.path])
    elif label == OPEN
        self.finder([e.path])
    elif label == COPY and e.path != ""
        self.out.push(app.clipboard(e.path))
        self.s.notice = "Copied {e.path}"
    elif label == SHOW
        self.s.filter = ""
        self.s.find = ""
        self.go(e.parent)
        self.s.sel = id
        row := self.s.shown().index_of(id) else 0
        self.s.top = (row.to_float() * state.ROW_H - 60.0).max(0.0).min(view.max_scroll(self.s))
    elif label == INTO
        self.go(id)
    elif label == MARK
        self.s.marks.add(id)
        self.s.undo = []
    elif label == UNMARK
        self.s.marks.remove(id)

## Runs `open` with `args` (Finder opens or reveals the path). The mock tree has no paths.
fn Husk.finder(mut self, args List[str])
    if (args.last() else "") == ""
        self.s.notice = "This is sample data; scan a folder to open real files."
        return
    r := proc.run("/usr/bin/open", args, "", 10000) else err
        self.s.notice = "open failed: {err}"
        return
    if not r.ok()
        self.s.notice = "open failed: {r.text().trim()}"

fn Husk.click(mut self, x float, y float, clicks int)
    r := view.hit(self.f, x, y) else return
    match r.kind
        "nav" =>
            self.s.filter = r.arg
            self.s.find = ""
            self.s.cur = 0
            self.s.sel = -1
            self.s.top = 0.0
        "crumb" => self.go(r.k)
        "target" => self.start(r.arg)
        "rescan" => self.start(self.last)
        "tile" | "row" =>
            e := self.s.m.entries[r.k]
            if self.s.sel == r.k and e.is_dir and not e.kids.is_empty()
                self.go(r.k)
            elif clicks >= 2 and not e.is_dir
                self.finder(["-R", e.path])
            else
                self.s.sel = r.k
        "check" =>
            if not self.s.marks.add(r.k)
                self.s.marks.remove(r.k)
            self.s.sel = r.k
            self.s.undo = []
        "sort" =>
            if self.s.sort_key == r.arg
                self.s.desc = not self.s.desc
            else
                self.s.sort_key = r.arg
                self.s.desc = r.arg != "name"
            self.s.top = 0.0
        "all_safe" =>
            for id in mock.rows(self.s.m, 0, "safe", self.s.eff)
                self.s.marks.add(id)
            self.s.undo = []
        "review" =>
            if not self.s.marks.is_empty()
                self.s.sheet = true
        "cancel" => self.cancel()
        "cloudbox" => self.s.cloud_delete = not self.s.cloud_delete
        "admin_go" => self.admin_go()
        "trash" => self.trash()
        "undo" => self.undo()
        _ => return

## Did the failure come from permissions? (fs.trash gives the OS's words.)
fn denied(text str) bool
    t := text.to_lower()
    t.contains("permission")
        or t.contains("denied")
        or t.contains("not permitted")
        or t.contains("read-only")

## Cancel on a sheet: the admin sheet skips its items, the review sheet just closes.
fn Husk.cancel(mut self)
    if not self.s.admin.is_empty()
        self.s.notice = "Skipped {self.s.admin.len()} items that need administrator permission."
        self.s.admin = []
    self.s.sheet = false

## Moves the marked entries out of the way. An item in iCloud Drive is offloaded
## (this Mac's copy goes, iCloud keeps the file) unless the sheet's box says to delete it from
## iCloud too. Everything else goes to the Trash with `fs.trash` (ADR 0929). An item
## the account may not remove waits for the admin sheet. Mock entries (no path) are only
## hidden, and Undo shows them again.
fn Husk.trash(mut self)
    ids := mock.top_marks(self.s.m, self.s.marks)
    mut moved := List[int]()
    mut need := List[int]()
    mut offloaded := 0
    mut real := false
    mut why := ""
    for id in ids
        e := self.s.m.entries[id]
        if e.path == ""
            self.s.gone.add(id)
            moved.push(id)
            continue
        real = true
        if e.icloud and not self.s.cloud_delete
            bad := if e.is_dir then sysops.evict(e.path) else sysops.evict_file(e.path)
            if bad == ""
                self.s.gone.add(id)
                offloaded += 1
                continue
            if bad != sysops.NOT_CLOUD
                log.warn("offload failed: {e.path}: {bad}")
                why = bad
                continue
        fs.trash(e.path) else err
            if denied("{err}")
                need.push(id)
            else
                log.warn("trash failed: {e.path}: {err}")
                why = "{err}"
            continue
        self.s.gone.add(id)
        moved.push(id)
    self.s.undo = List[int]()
    self.s.notice = why
    if not real
        self.s.undo = moved
    elif why == ""
        self.s.notice = "Moved {moved.len()} to the Trash (Put Back in Finder restores them). Offloaded {offloaded} to iCloud."
    self.s.marks = {}
    self.s.sel = -1
    self.s.eff = mock.sizes(self.s.m, self.s.gone)
    if self.s.eff[self.s.cur] <= 0
        self.s.cur = 0
    self.s.admin = need
    self.s.sheet = not need.is_empty()
    self.s.cloud_delete = false

## The admin sheet's Allow: delete the waiting items with one macOS password prompt.
fn Husk.admin_go(mut self)
    mut paths := List[str]()
    for id in self.s.admin
        paths.push(self.s.m.entries[id].path)
    bad := sysops.remove_admin(paths)
    if bad == ""
        for id in self.s.admin
            self.s.gone.add(id)
        self.s.notice = "Deleted {self.s.admin.len()} items with administrator permission."
        self.s.eff = mock.sizes(self.s.m, self.s.gone)
        if self.s.eff[self.s.cur] <= 0
            self.s.cur = 0
    else
        self.s.notice = bad
    self.s.admin = []
    self.s.sheet = false

fn Husk.undo(mut self)
    for id in self.s.undo
        self.s.gone.remove(id)
    self.s.undo = []
    self.s.eff = mock.sizes(self.s.m, self.s.gone)

## Keys: Escape closes the sheet, Backspace goes up, the arrows move the selection,
## Return looks inside the selected folder (or reveals a file), Space ticks it.
fn Husk.key(mut self, name str)
    k := name.to_lower()
    if self.s.sheet
        if k == "escape"
            self.cancel()
        return
    if k == "backspace" and self.s.filter == "" and self.s.cur > 0
        self.go(self.s.m.entries[self.s.cur].parent)
        return
    ids := self.s.shown()
    if ids.is_empty()
        return
    at := ids.index_of(self.s.sel) else -1
    if k == "down" or k == "up"
        mut n := (at - 1).max(0)
        if at < 0
            n = 0
        elif k == "down"
            n = (at + 1).min(ids.len() - 1)
        self.s.sel = ids[n]
        # Keep the selected row in view.
        ry := n.to_float() * state.ROW_H
        if ry < self.s.top
            self.s.top = ry
        elif ry + state.ROW_H > self.s.top + view.list_height(self.s)
            self.s.top = (ry + state.ROW_H - view.list_height(self.s)).min(view.max_scroll(self.s))
    elif k == "enter" and at >= 0
        e := self.s.m.entries[self.s.sel]
        if e.is_dir and not e.kids.is_empty()
            self.go(self.s.sel)
        else
            self.finder(["-R", e.path])
    elif k == " " and at >= 0
        if not self.s.marks.add(self.s.sel)
            self.s.marks.remove(self.s.sel)
        self.s.undo = []

fn fresh() Husk
    mut h := Husk(
        s: state.State.new(mock.mock()),
        done: Channel[mock.Model](1),
        reqs: Channel[Req](1),
        last: "home",
        picking: false,
        f: state.Frame(ops: [], regs: []),
        menu: none,
        menu_for: -1,
        out: [],
    )
    h.s.scanned = true
    h.s.targets = targets()
    h.f = view.draw(h.s)
    h

## A one-entry tree for before the first scan.
fn placeholder() mock.Model
    mut m := mock.Model(entries: [], vol_total: 0, vol_used: 0, kinds: [])
    mock.add(mut m, -1, "This Mac", 1, true, "keep", "", "", "")
    m

## The scan task: for each request, scan its roots, build the tree, tell the window.
fn scanner(inbox app.Inbox, reqs Channel[Req], done Channel[mock.Model])
    while true
        r := reqs.recv() else break
        n := r.roots.len()
        mut parts := List[scan.Scan]()
        mut files := 0
        mut failed := ""
        for i in 0..n
            root := r.roots[i]
            pct := (i.to_float() / n.to_float()).max(0.02)
            inbox.post(app.external("scan", "{pct}|{files}|{root}"))
            sc := scan.scan(root) else err
                failed = "{root}: {err}"
                continue
            files += sc.files.len()
            parts.push(sc)
        if parts.is_empty()
            inbox.post(app.external("scan_failed", failed))
            continue
        merged := bridge.merge(parts)
        floor := (merged.total / 3000).max(1).min(67108864)
        mut tree := bridge.tree(merged, r.label, home(), time.now_ms(), floor)
        v := fs.volume(r.roots[0]) else err
            done.send(tree)
            inbox.post(app.external("scan_done", ""))
            continue
        tree.vol_total = v.total
        tree.vol_used = v.total - v.free
        done.send(tree)
        inbox.post(app.external("scan_done", ""))

## Opens the window on the mock tree with no scan, for captures and review
## (`husk gui --demo`).
pub fn demo()
    mut h := fresh()
    inbox := app.new_inbox()
    g := TaskGroup()
    g.add(spawn scanner(inbox, h.reqs, h.done))
    host := app.host_path() else err
        print("no window: {err.kind}: {err.message}")
        h.reqs.close()
        return
    app.run_with(mut h, host, [], inbox) else err
        print("no window: {err.kind}: {err.message}")
    h.reqs.close()

## Opens the window. A non-empty `root` is scanned at once.
pub fn run(root str)
    done := Channel[mock.Model](1)
    reqs := Channel[Req](1)
    mut h := Husk(
        s: state.State.new(placeholder()),
        done: done,
        reqs: reqs,
        last: "",
        picking: false,
        f: state.Frame(ops: [], regs: []),
        menu: none,
        menu_for: -1,
        out: [],
    )
    h.s.targets = targets()
    inbox := app.new_inbox()
    g := TaskGroup()
    g.add(spawn scanner(inbox, reqs, done))
    if root != ""
        h.start(root)
    h.f = view.draw(h.s)
    host := app.host_path() else err
        print("no window: {err.kind}: {err.message}")
        reqs.close()
        return
    app.run_with(mut h, host, [], inbox) else err
        print("no window: {err.kind}: {err.message}")
    reqs.close()

@test fn starts_on_the_overview()
    mut h := fresh()
    screens := app.script(mut h, [app.event(app.EventKind.Start)])
    assert(screens[0].contains("canvas #main"))
    assert_eq(h.s.cur, 0)

@test fn ticking_and_trashing_frees_space()
    mut h := fresh()
    before := h.s.eff[0]
    h.s.filter = "safe"
    for id in mock.rows(h.s.m, 0, "safe", h.s.eff)
        h.s.marks.add(id)
    freed := h.s.reclaim()
    assert(freed > 0)
    h.trash()
    assert_eq(h.s.eff[0], before - freed)
    h.undo()
    assert_eq(h.s.eff[0], before)

@test fn scan_events_drive_progress()
    mut h := fresh()
    ev := app.external("scan", "0.25|1200|/Users/kaleb")
    h.update(ev)
    assert(h.s.pct < 0.3)
    assert(h.s.scan_note.contains("1200 files"))

@test fn overview_has_regions()
    h := fresh()
    f := view.draw(h.s)
    assert(f.regs.len() > 10)

@test fn targets_map_to_roots()
    assert_eq(roots_of("library").len(), 1)
    assert_eq(roots_of("smart").len(), 3)
    assert_eq(roots_of("/tmp/x"), ["/tmp/x"])

@test fn typing_a_folder_starts_a_scan()
    mut h := fresh()
    h.s.scanned = false
    h.update(app.edit("path", "/tmp/x"))
    mut e := app.event(app.EventKind.Submit)
    e.id = "path"
    h.update(e)
    assert_eq(h.s.path, "/tmp/x")
    assert(h.s.pct < 1.0)
    assert_eq(h.last, "/tmp/x")

@test fn denied_reads_the_operating_systems_words()
    assert(denied("Permission denied"))
    assert(denied("Operation not permitted"))
    assert(not denied("no such file"))

@test fn cancel_on_the_admin_sheet_skips_its_items()
    mut h := fresh()
    h.s.admin = [1, 2]
    h.s.sheet = true
    h.cancel()
    assert(h.s.admin.is_empty())
    assert(not h.s.sheet)
    assert(h.s.notice.contains("2 items"))

@test fn search_finds_names_anywhere()
    mut h := fresh()
    h.update(app.edit("find", "cache"))
    assert_eq(h.s.filter, "find:cache")
    ids := h.s.shown()
    assert(not ids.is_empty())
    for id in ids
        assert(h.s.m.entries[id].name.to_lower().contains("cache"))
    h.update(app.edit("find", ""))
    assert_eq(h.s.filter, "")

@test fn right_click_opens_a_menu_and_ticks()
    mut h := fresh()
    tile := [r for r in h.f.regs if r.kind == "tile"][0]
    mut ev := app.event(app.EventKind.Click)
    ev.id = "main"
    ev.text = "right"
    ev.x = tile.x + 4.0
    ev.y = tile.y + 4.0
    h.update(ev)
    menu := h.popup() else unreachable("no menu")
    assert(menu.items.contains(MARK))
    mut pick := app.event(app.EventKind.Popup)
    pick.id = "item"
    pick.text = MARK
    h.update(pick)
    assert(h.popup() == none)
    assert(h.s.marks.contains(tile.k))

@test fn copy_path_sends_a_clipboard_line()
    mut h := fresh()
    h.s.m.entries[1].path = "/Users/me/x"
    h.menu_for = 1
    h.act(COPY)
    assert_eq(h.lines().len(), 1)
    assert(h.lines().is_empty())

@test fn hovering_a_tile_shows_its_card()
    mut h := fresh()
    tile := [r for r in h.f.regs if r.kind == "tile"][0]
    mut ev := app.event(app.EventKind.Move)
    ev.id = "main"
    ev.x = tile.x + 4.0
    ev.y = tile.y + 4.0
    h.update(ev)
    assert_eq(h.s.hover, tile.k)
    h.update(app.event(app.EventKind.Leave))
    assert_eq(h.s.hover, -1)

@test fn arrows_move_the_selection()
    mut h := fresh()
    h.update(app.key("down"))
    first := h.s.sel
    assert(first >= 0)
    h.update(app.key("down"))
    assert(h.s.sel != first)
    h.update(app.key(" "))
    assert(h.s.marks.contains(h.s.sel))
