## Husk's window: finds what is using your disk and says what is safe to delete.
## This file is the std.app shell: it owns the `State` (view/view.ail) and turns
## events into changes. Run on macOS from the ail checkout:
##   tools/app-host/macos/run.sh path/to/husk/husk.ail gui [FOLDER]
## The window opens on a welcome page: pick Smart scan, a folder button, or type a
## folder in the field and press Return. With a FOLDER argument it scans that at
## once. The scan runs in a task, so the window stays responsive.

use std.app
use std.log
use mock
use view
use bridge
use scan
use sysops

## What to scan: the roots, and the name of the top entry of the result.
struct Req
    roots List[str]
    label str

struct Husk
    s view.State
    ## Where the scan task leaves the finished tree.
    done Channel[mock.Model]
    ## Scan requests for the scan task.
    reqs Channel[Req]
    ## The target id of the last scan, for Rescan.
    last str
    ## A folder dialog is open (std.app.21).
    picking bool
    ## The frame last drawn: clicks and pointer moves are looked up in it.
    f view.Frame
    ## The right-click menu while it is open (std.app.18) and the entry it is for.
    menu app.Popup?
    menu_for int
    ## Lines for the host, such as the clipboard (std.app.21, std.app.26).
    out List[str]

impl app.App for Husk
    fn update(mut self, ev app.Event)
        if ev.kind == "move" or ev.kind == "leave"
            if not pointer(ev)
                return
        else
            handle(ev)
        f = view.draw(s)

    fn view(self) app.Node
        app.column([
            app.row([
                app.field("path", s.path, "Folder to scan, such as ~/Library (~ is your home)"),
                app.button("go", "Scan"),
                app.field("find", s.find, "Search names"),
            ]),
            app.canvas("main", 0.0, 0.0, f.ops),
        ])

    fn title(self) str
        "Husk"

    fn hover(self) bool
        s.scanned

    fn popup(self) app.Popup?
        menu

    fn lines(mut self) List[str]
        sent := out
        out = []
        sent

    fn pick(self) app.Picker?
        if picking
            return app.Picker(
                id: "folder",
                prompt: "Choose a folder to scan",
                folders: true,
                start: home(),
            )
        none

    fn focus(self) str
        if s.scanned
            return ""
        "path"

## One event other than a pointer move.
fn Husk.handle(mut self, ev app.Event)
    match ev.kind
        "resize" if ev.id == "main" =>
            s.w = ev.dx
            s.h = ev.dy
            s.top = s.top.min(view.max_scroll(s))
            s.side_top = s.side_top.min(view.side_max(s))
        "scroll" if s.mx < view.SIDE_W =>
            s.side_top = (s.side_top + ev.dy).max(0.0).min(view.side_max(s))
        "scroll" =>
            s.top = (s.top + ev.dy).max(0.0).min(view.max_scroll(s))
        "click" if ev.id == "main" and ev.text == "left" => click(ev.x, ev.y, ev.clicks)
        "click" if ev.id == "main" and ev.text == "right" => context(ev.x, ev.y)
        "popup" =>
            menu = none
            act(ev.text)
        "key" => key(ev.text)
        "edit" if ev.id == "path" => s.path = ev.text
        "edit" if ev.id == "find" => search(ev.text)
        "submit" if ev.id == "path" => start(s.path)
        "press" if ev.id == "go" => start(s.path)
        "picked" =>
            picking = false
            if ev.text != ""
                s.path = ev.text
                start(ev.text)
        "pick_error" =>
            picking = false
            s.notice = "{ev.text}. Type the folder in the field instead."
        "external" if ev.id == "scan" => progress(ev.text)
        "external" if ev.id == "scan_done" => finished()
        "external" if ev.id == "scan_failed" => failed(ev.text)
        _ => return

## A scan update from the scanner: `pct|files|bytes|path`.
fn Husk.progress(mut self, text str)
    parts := text.split("|")
    if parts.len() < 4
        return
    s.pct = (parts[0].to_float() else 1.0).max(0.02).min(0.99)
    files := parts[1].to_int() else 0
    bytes := parts[2].to_int() else 0
    s.scan_note = "{mock.fmt_size(bytes)} · {files} items · {parts[3]}"

## The scan task is done: take its tree.
fn Husk.finished(mut self)
    m := done.recv() else return
    s.m = m
    s.gone = {}
    s.marks = {}
    s.eff = mock.sizes(m, s.gone)
    s.cur = 0
    if m.entries[0].kids.len() == 1
        s.cur = m.entries[0].kids[0]
    s.filter = ""
    s.scanned = true
    s.top = 0.0
    s.sel = -1
    s.pct = 1.0
    s.scan_note = ""
    s.notice = ""

fn Husk.failed(mut self, text str)
    s.pct = 1.0
    s.notice = "Scan failed: {text}"

fn home() str
    env.home() else "/"

## The roots a target id stands for. Anything else is a folder path (`~` is home).
fn roots_of(id str) List[str]
    h := home()
    if id == "smart"
        return [h, "/Library", "/Applications"]
    if id == "home"
        return [h]
    if id == "dev"
        return ["{h}/Library/Developer"]
    if id == "library"
        return ["{h}/Library"]
    if id == "disk"
        return ["/Users", "/Library", "/Applications", "/opt", "/usr/local"]
    if id == "~"
        return [h]
    if id.starts_with("~/")
        return ["{h}/{id.slice(2, id.len())}"]
    [id]

fn targets() List[view.Target]
    [
        view.Target(
            id: "smart",
            label: "Smart scan",
            detail: "Home, /Library and Applications: caches, Xcode data, simulators, wallpapers, installers",
        ),
        view.Target(
            id: "choose",
            label: "Choose folder…",
            detail: "Pick any folder in the macOS dialog",
        ),
        view.Target(id: "home", label: "Home folder", detail: "Everything in your user folder"),
        view.Target(
            id: "dev",
            label: "Xcode and simulators",
            detail: "~/Library/Developer: DerivedData, device support, simulator devices",
        ),
        view.Target(
            id: "library",
            label: "Library",
            detail: "~/Library: app caches, logs, containers",
        ),
        view.Target(
            id: "disk",
            label: "Whole disk",
            detail: "Every user, /Library, Applications; not macOS system files",
        ),
    ]

## Asks the scan task to scan a target id or a folder path, unless a scan is running.
fn Husk.start(mut self, id str)
    t := id.trim()
    if t == "choose"
        picking = true
        return
    if t == "" or s.pct < 1.0
        return
    roots := roots_of(t)
    label := if roots.len() == 1 then roots[0] else "This Mac"
    s.pct = 0.02
    s.scan_note = roots.join(", ")
    s.notice = ""
    last = t
    reqs.send(Req(roots: roots, label: label))

fn Husk.go(mut self, id int)
    s.cur = id
    s.filter = ""
    s.sel = -1
    s.top = 0.0

## A pointer `move` or `leave`: true when the hovered tile or row changed, so the
## tooltip must be drawn again. The tooltip stays where the pointer entered.
fn Husk.pointer(mut self, ev app.Event) bool
    mut id := -1
    if ev.kind == "move"
        s.mx = ev.x
        if r := view.hit(f, ev.x, ev.y)
            if r.kind == "tile" or r.kind == "row"
                id = r.k
    if id == s.hover
        return false
    s.hover = id
    s.hx = ev.x
    s.hy = ev.y
    true

## The search field changed: show the entries whose names contain the text.
fn Husk.search(mut self, text str)
    s.find = text
    q := text.trim()
    s.filter = if q == "" then "" else "find:{q}"
    s.sel = -1
    s.top = 0.0

## A right-click on a tile or row selects it and opens its menu.
fn Husk.context(mut self, x float, y float)
    r := view.hit(f, x, y) else return
    if r.kind != "tile" and r.kind != "row" and r.kind != "check"
        return
    s.sel = r.k
    s.hover = -1
    menu_for = r.k
    menu = app.Popup(id: "item", x: x, y: y, items: menu_items(r.k))

## The right-click menu for entry `id`.
fn Husk.menu_items(self, id int) List[str]
    e := s.m.entries[id]
    mut items := [REVEAL, OPEN, COPY]
    if s.filter != ""
        items.push(SHOW)
    if e.is_dir and not e.kids.is_empty()
        items.push(INTO)
    items.push(if s.marks.contains(id) then UNMARK else MARK)
    items

REVEAL := "Reveal in Finder"
OPEN := "Open"
COPY := "Copy Path"
SHOW := "Show in Enclosing Folder"
INTO := "Look Inside"
MARK := "Tick for the Trash"
UNMARK := "Untick"

## A menu choice for the entry the menu was opened on; `""` is a dismissed menu.
fn Husk.act(mut self, label str)
    id := menu_for
    if id < 0 or id >= s.m.entries.len()
        return
    e := s.m.entries[id]
    if label == REVEAL
        finder(["-R", e.path])
    elif label == OPEN
        finder([e.path])
    elif label == COPY and e.path != ""
        out.push(app.clipboard(e.path))
        s.notice = "Copied {e.path}"
    elif label == SHOW
        s.filter = ""
        s.find = ""
        go(e.parent)
        s.sel = id
        row := s.shown().index_of(id) else 0
        s.top = (row.to_float() * view.ROW_H - 60.0).max(0.0).min(view.max_scroll(s))
    elif label == INTO
        go(id)
    elif label == MARK
        s.marks.add(id)
        s.undo = []
    elif label == UNMARK
        s.marks.remove(id)

## Runs `open` with `args` (Finder opens or reveals the path). The mock tree has no paths.
fn Husk.finder(mut self, args List[str])
    if (args.last() else "") == ""
        s.notice = "This is sample data; scan a folder to open real files."
        return
    r := proc.run("/usr/bin/open", args, "", 10000) else err
        s.notice = "open failed: {err}"
        return
    if not r.ok()
        s.notice = "open failed: {r.text().trim()}"

fn Husk.click(mut self, x float, y float, clicks int)
    r := view.hit(f, x, y) else return
    match r.kind
        "nav" =>
            s.filter = r.arg
            s.find = ""
            s.cur = 0
            s.sel = -1
            s.top = 0.0
        "crumb" => go(r.k)
        "target" => start(r.arg)
        "rescan" => start(last)
        "tile" | "row" =>
            e := s.m.entries[r.k]
            if s.sel == r.k and e.is_dir and not e.kids.is_empty()
                go(r.k)
            elif clicks >= 2 and not e.is_dir
                finder(["-R", e.path])
            else
                s.sel = r.k
        "check" =>
            if not s.marks.add(r.k)
                s.marks.remove(r.k)
            s.sel = r.k
            s.undo = []
        "sort" =>
            if s.sort_key == r.arg
                s.desc = not s.desc
            else
                s.sort_key = r.arg
                s.desc = r.arg != "name"
            s.top = 0.0
        "all_safe" =>
            for id in mock.rows(s.m, 0, "safe", s.eff)
                s.marks.add(id)
            s.undo = []
        "review" =>
            if not s.marks.is_empty()
                s.sheet = true
        "cancel" => cancel()
        "cloudbox" => s.cloud_delete = not s.cloud_delete
        "admin_go" => admin_go()
        "trash" => trash()
        "undo" => undo()
        _ => return

## Did the failure come from permissions? (fs.trash gives the OS's words.)
fn denied(text str) bool
    t := text.to_lower()
    t.contains("permission")
        or t.contains("denied")
        or t.contains("not permitted")
        or t.contains("read-only")

## Cancel on a sheet: the admin sheet skips its items, the review sheet just closes.
fn Husk.cancel(mut self)
    if not s.admin.is_empty()
        s.notice = "Skipped {s.admin.len()} items that need administrator permission."
        s.admin = []
    s.sheet = false

## Moves the marked entries out of the way. An item in iCloud Drive is offloaded
## (this Mac's copy goes, iCloud keeps the file) unless the sheet's box says to delete it from
## iCloud too. Everything else goes to the Trash with `fs.trash` (ADR 0929). An item
## the account may not remove waits for the admin sheet. Mock entries (no path) are only
## hidden, and Undo shows them again.
fn Husk.trash(mut self)
    ids := mock.top_marks(s.m, s.marks)
    mut moved := List[int]()
    mut need := List[int]()
    mut offloaded := 0
    mut real := false
    mut why := ""
    for id in ids
        e := s.m.entries[id]
        if e.path == ""
            s.gone.add(id)
            moved.push(id)
            continue
        real = true
        if e.icloud and not s.cloud_delete
            bad := if e.is_dir then sysops.evict(e.path) else sysops.evict_file(e.path)
            if bad == ""
                s.gone.add(id)
                offloaded += 1
                continue
            if bad != sysops.NOT_CLOUD
                log.warn("offload failed: {e.path}: {bad}")
                why = bad
                continue
        fs.trash(e.path) else err
            if denied("{err}")
                need.push(id)
            else
                log.warn("trash failed: {e.path}: {err}")
                why = "{err}"
            continue
        s.gone.add(id)
        moved.push(id)
    s.undo = List[int]()
    s.notice = why
    if not real
        s.undo = moved
    elif why == ""
        s.notice = "Moved {moved.len()} to the Trash (Put Back in Finder restores them). Offloaded {offloaded} to iCloud."
    s.marks = {}
    s.sel = -1
    s.eff = mock.sizes(s.m, s.gone)
    if s.eff[s.cur] <= 0
        s.cur = 0
    s.admin = need
    s.sheet = not need.is_empty()
    s.cloud_delete = false

## The admin sheet's Allow: delete the waiting items with one macOS password prompt.
fn Husk.admin_go(mut self)
    mut paths := List[str]()
    for id in s.admin
        paths.push(s.m.entries[id].path)
    bad := sysops.remove_admin(paths)
    if bad == ""
        for id in s.admin
            s.gone.add(id)
        s.notice = "Deleted {s.admin.len()} items with administrator permission."
        s.eff = mock.sizes(s.m, s.gone)
        if s.eff[s.cur] <= 0
            s.cur = 0
    else
        s.notice = bad
    s.admin = []
    s.sheet = false

fn Husk.undo(mut self)
    for id in s.undo
        s.gone.remove(id)
    s.undo = []
    s.eff = mock.sizes(s.m, s.gone)

## Keys: Escape closes the sheet, Backspace goes up, the arrows move the selection,
## Return looks inside the selected folder (or reveals a file), Space ticks it.
fn Husk.key(mut self, name str)
    k := name.to_lower()
    if s.sheet
        if k == "escape"
            cancel()
        return
    if k == "backspace" and s.filter == "" and s.cur > 0
        go(s.m.entries[s.cur].parent)
        return
    ids := s.shown()
    if ids.is_empty()
        return
    at := ids.index_of(s.sel) else -1
    if k == "down" or k == "up"
        mut n := (at - 1).max(0)
        if at < 0
            n = 0
        elif k == "down"
            n = (at + 1).min(ids.len() - 1)
        s.sel = ids[n]
        # Keep the selected row in view.
        ry := n.to_float() * view.ROW_H
        if ry < s.top
            s.top = ry
        elif ry + view.ROW_H > s.top + view.list_height(s)
            s.top = (ry + view.ROW_H - view.list_height(s)).min(view.max_scroll(s))
    elif k == "enter" and at >= 0
        e := s.m.entries[s.sel]
        if e.is_dir and not e.kids.is_empty()
            go(s.sel)
        else
            finder(["-R", e.path])
    elif k == " " and at >= 0
        if not s.marks.add(s.sel)
            s.marks.remove(s.sel)
        s.undo = []

fn fresh() Husk
    mut h := Husk(
        s: view.State.new(mock.mock()),
        done: Channel[mock.Model](1),
        reqs: Channel[Req](1),
        last: "home",
        picking: false,
        f: view.Frame(ops: [], regs: []),
        menu: none,
        menu_for: -1,
        out: [],
    )
    h.s.scanned = true
    h.s.targets = targets()
    h.f = view.draw(h.s)
    h

## A one-entry tree for before the first scan.
fn placeholder() mock.Model
    mut m := mock.Model(entries: [], vol_total: 0, vol_used: 0, kinds: [])
    mock.add(mut m, -1, "This Mac", 1, true, "keep", "", "", "")
    m

## The scan task: for each request, scan its roots, build the tree, tell the window.
## How often the progress bar moves while a scan runs.
TICK_MS := 150

## While `stop` is 0, posts what the scans have listed since `base` (fs.scan_count,
## ADR 0992): against `expected` bytes when known, else as root `i` of `n`.
fn ticker(inbox app.Inbox, stop Atomic[int], base fs.ScanCount, expected int, i int, n int, root str)
    while stop.load() == 0
        c := fs.scan_count()
        items := c.entries - base.entries
        bytes := c.bytes - base.bytes
        pct := if expected > 0 then bytes.to_float() / expected.to_float() else (i.to_float() + 0.5) / n.to_float()
        inbox.post(app.external("scan", "{pct}|{items}|{bytes}|{root}"))
        time.sleep_ms(TICK_MS)

## The bytes a request will probably list: the last scan of the same roots, else the
## volume's used bytes for a whole-disk scan, else 0 (unknown).
fn expect(r Req, seen Map[str, int]) int
    key := r.roots.join("|")
    if n := seen.get(key)
        return n
    if r.roots.len() < 3
        return 0
    v := fs.volume(r.roots[0]) else return 0
    v.total - v.free

fn scanner(inbox app.Inbox, reqs Channel[Req], done Channel[mock.Model])
    mut seen := Map[str, int]()
    while true
        r := reqs.recv() else break
        n := r.roots.len()
        mut parts := List[scan.Scan]()
        mut failed := ""
        expected := expect(r, seen)
        base := fs.scan_count()
        for i in 0..n
            root := r.roots[i]
            stop := Atomic(0)
            t := spawn ticker(inbox, stop, base, expected, i, n, root)
            mut why := ""
            sc := scan.scan(root) else err
                why = "{err}"
                scan.Scan(root: root, files: [], dirs: {}, total: 0, errors: [])
            stop.store(1)
            t.wait() else err
                log.warn("progress task: {err}")
            if why != ""
                failed = "{root}: {why}"
                continue
            parts.push(sc)
        if parts.is_empty()
            inbox.post(app.external("scan_failed", failed))
            continue
        merged := bridge.merge(parts)
        seen[r.roots.join("|")] = fs.scan_count().bytes - base.bytes
        floor := (merged.total / 3000).max(1).min(67108864)
        mut tree := bridge.tree(merged, r.label, home(), time.now_ms(), floor)
        v := fs.volume(r.roots[0]) else err
            done.send(tree)
            inbox.post(app.external("scan_done", ""))
            continue
        tree.vol_total = v.total
        tree.vol_used = v.total - v.free
        done.send(tree)
        inbox.post(app.external("scan_done", ""))

## Opens the window. A non-empty `root` is scanned at once.
pub fn run(root str)
    done := Channel[mock.Model](1)
    reqs := Channel[Req](1)
    mut h := Husk(
        s: view.State.new(placeholder()),
        done: done,
        reqs: reqs,
        last: "",
        picking: false,
        f: view.Frame(ops: [], regs: []),
        menu: none,
        menu_for: -1,
        out: [],
    )
    h.s.targets = targets()
    inbox := app.new_inbox()
    g := TaskGroup()
    g.add(spawn scanner(inbox, reqs, done))
    if root != ""
        h.start(root)
    h.f = view.draw(h.s)
    host := app.host_path() else err
        print("no window: {err.kind}: {err.message}")
        reqs.close()
        return
    app.run_with(mut h, host, [], inbox) else err
        print("no window: {err.kind}: {err.message}")
    reqs.close()

@test fn starts_on_the_overview()
    mut h := fresh()
    screens := app.script(mut h, [app.event("start")])
    assert(screens[0].contains("canvas #main"))
    assert_eq(h.s.cur, 0)

@test fn ticking_and_trashing_frees_space()
    mut h := fresh()
    before := h.s.eff[0]
    h.s.filter = "safe"
    for id in mock.rows(h.s.m, 0, "safe", h.s.eff)
        h.s.marks.add(id)
    freed := h.s.reclaim()
    assert(freed > 0)
    h.trash()
    assert_eq(h.s.eff[0], before - freed)
    h.undo()
    assert_eq(h.s.eff[0], before)

@test fn scan_events_drive_progress()
    mut h := fresh()
    ev := app.external("scan", "0.25|1200|3145728|/Users/kaleb")
    h.update(ev)
    assert(h.s.pct < 0.3)
    assert(h.s.scan_note.contains("1200 items"))
    assert(h.s.scan_note.contains("3 MB"))

@test fn overview_has_regions()
    h := fresh()
    f := view.draw(h.s)
    assert(f.regs.len() > 10)

@test fn targets_map_to_roots()
    assert_eq(roots_of("library").len(), 1)
    assert_eq(roots_of("smart").len(), 3)
    assert_eq(roots_of("/tmp/x"), ["/tmp/x"])

@test fn typing_a_folder_starts_a_scan()
    mut h := fresh()
    h.s.scanned = false
    h.update(app.edit("path", "/tmp/x"))
    mut e := app.event("submit")
    e.id = "path"
    h.update(e)
    assert_eq(h.s.path, "/tmp/x")
    assert(h.s.pct < 1.0)
    assert_eq(h.last, "/tmp/x")

@test fn denied_reads_the_operating_systems_words()
    assert(denied("Permission denied"))
    assert(denied("Operation not permitted"))
    assert(not denied("no such file"))

@test fn cancel_on_the_admin_sheet_skips_its_items()
    mut h := fresh()
    h.s.admin = [1, 2]
    h.s.sheet = true
    h.cancel()
    assert(h.s.admin.is_empty())
    assert(not h.s.sheet)
    assert(h.s.notice.contains("2 items"))

@test fn search_finds_names_anywhere()
    mut h := fresh()
    h.update(app.edit("find", "cache"))
    assert_eq(h.s.filter, "find:cache")
    ids := h.s.shown()
    assert(not ids.is_empty())
    for id in ids
        assert(h.s.m.entries[id].name.to_lower().contains("cache"))
    h.update(app.edit("find", ""))
    assert_eq(h.s.filter, "")

@test fn right_click_opens_a_menu_and_ticks()
    mut h := fresh()
    tile := [r for r in h.f.regs if r.kind == "tile"][0]
    mut ev := app.event("click")
    ev.id = "main"
    ev.text = "right"
    ev.x = tile.x + 4.0
    ev.y = tile.y + 4.0
    h.update(ev)
    menu := h.popup() else unreachable("no menu")
    assert(menu.items.contains(MARK))
    mut pick := app.event("popup")
    pick.id = "item"
    pick.text = MARK
    h.update(pick)
    assert(h.popup() == none)
    assert(h.s.marks.contains(tile.k))

@test fn copy_path_sends_a_clipboard_line()
    mut h := fresh()
    h.s.m.entries[1].path = "/Users/me/x"
    h.menu_for = 1
    h.act(COPY)
    assert_eq(h.lines().len(), 1)
    assert(h.lines().is_empty())

@test fn hovering_a_tile_shows_its_card()
    mut h := fresh()
    tile := [r for r in h.f.regs if r.kind == "tile"][0]
    mut ev := app.event("move")
    ev.id = "main"
    ev.x = tile.x + 4.0
    ev.y = tile.y + 4.0
    h.update(ev)
    assert_eq(h.s.hover, tile.k)
    h.update(app.event("leave"))
    assert_eq(h.s.hover, -1)

@test fn arrows_move_the_selection()
    mut h := fresh()
    h.update(app.key("down"))
    first := h.s.sel
    assert(first >= 0)
    h.update(app.key("down"))
    assert(h.s.sel != first)
    h.update(app.key(" "))
    assert(h.s.marks.contains(h.s.sel))
