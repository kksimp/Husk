## kinds: what sort of file a path is (video, photos, archives…), from its name,
## and the totals per kind over a whole scan. Names only: no file is opened.

use model

## A file kind: `id` is the filter key, `name` the sidebar title.
pub struct Kind
    pub id str
    pub name str
    pub bytes int
    pub count int

## The kinds in sidebar order; `other` is everything else.
pub KINDS := [
    ("video", "Movies"),
    ("audio", "Music & audio"),
    ("images", "Pictures"),
    ("archives", "Archives & disk images"),
    ("apps", "Apps"),
    ("vm", "Virtual machines"),
    ("docs", "Documents"),
    ("code", "Code & build output"),
    ("other", "Other"),
]

