## Gives every folder with children the sum of its children's sizes.
pub fn finish(mut m Model)
    mut i := m.entries.len() - 1
    while i >= 0
        if not m.entries[i].kids.is_empty()
            mut t := 0
            for k in m.entries[i].kids
                t += m.entries[k].size
            m.entries[i].size = t
        i -= 1

## Each entry's size with trashed entries (`gone`) removed: a trashed entry
## counts 0 and its size comes off every folder above it. A folder's size is
## its scanned total, which may be more than its listed children.
pub fn sizes(m Model, gone Set[int]) List[int]
    mut out := [e.size for e in m.entries]
    for g in 0..m.entries.len()
        if not gone.contains(g)
            continue
        if g > 0 and covered(m, m.entries[g].parent, gone)
            out[g] = 0
            continue
        amount := m.entries[g].size
        mut cur := m.entries[g].parent
        while cur >= 0
            out[cur] -= amount
            cur = m.entries[cur].parent
        out[g] = 0
    out

## Is `id` under (or equal to) an entry in `marks`?
pub fn covered(m Model, id int, marks Set[int]) bool
    mut cur := id
    while cur >= 0
        if marks.contains(cur)
            return true
        cur = m.entries[cur].parent
    false

## The marked entries that count: those with no marked ancestor.
pub fn top_marks(m Model, marks Set[int]) List[int]
    mut out := List[int]()
    for id in 0..m.entries.len()
        if marks.contains(id) and not covered(m, m.entries[id].parent, marks)
            out.push(id)
    out

## Files at least this big are "large".
pub BIG := 100 * MB
## Files not modified for this many days are "old".
pub OLD_DAYS := 365

## Is `filter` one that `hit` answers (not a safety or category filter)?
fn own_filter(filter str) bool
    filter == "big" or filter == "old" or filter.starts_with("kind:") or filter.starts_with("find:")

## Does entry `e` match the filter `big`, `old`, `kind:ID` or `find:TEXT`?
pub fn hit(e Entry, filter str) bool
    if filter == "big"
        return not e.is_dir and e.size >= BIG
    if filter == "old"
        return not e.is_dir and e.days >= OLD_DAYS
    k := filter.strip_prefix("kind:") else ""
    if k != ""
        return not e.is_dir and e.kind == k
    q := filter.strip_prefix("find:") else ""
    if q != ""
        return e.name.to_lower().contains(q.to_lower())
    false

## The entries a view shows. `filter` is empty (the children of `cur`),
## `safe` (every safe entry whose parent is not safe), a category id (the
## top-most entries of that category), `big` (large files), `old` (files not
## changed for a year), `kind:ID` (files of a kind) or `find:TEXT` (top-most
## entries whose name contains TEXT, ignoring case).
pub fn rows(m Model, cur int, filter str, eff List[int]) List[int]
    mut out := List[int]()
    if filter == ""
        for k in m.entries[cur].kids
            if eff[k] > 0
                out.push(k)
        return out
    for id in 1..m.entries.len()
        e := m.entries[id]
        if eff[id] <= 0
            continue
        pe := m.entries[e.parent]
        if own_filter(filter)
            # A folder that matches a search hides the matches inside it.
            if hit(e, filter) and not (filter.starts_with("find:") and e.parent > 0 and hit(pe, filter))
                out.push(id)
            continue
        hit := if filter == "safe" then e.safety == "safe"
            and pe.safety != "safe" else e.cat == filter
            and pe.cat != filter
        if hit
            out.push(id)
    out

## The size of everything a filter finds, for the sidebar.
pub fn filter_total(m Model, filter str, eff List[int]) int
    mut s := 0
    for id in rows(m, 0, filter, eff)
        s += eff[id]
    s

## The path of `id`, root first.
pub fn trail(m Model, id int) List[int]
    mut out := List[int]()
    mut cur := id
    while cur >= 0
        out.insert(0, cur)
        cur = m.entries[cur].parent
    out

## `1.5 GB`, `320 MB`, `12 KB`.
pub fn fmt_size(n int) str
    x := n.to_float()
    if n >= GB
        return "{x / 1073741824.0:.1} GB"
    if n >= MB
        return "{(x / 1048576.0).round().to_int()} MB"
    if n >= 1024
        return "{(x / 1024.0).round().to_int()} KB"
    "{n} B"

@test fn file_views_list_matching_files()
    mut m := Model(entries: [], vol_total: 0, vol_used: 0, kinds: [])
    top := add(mut m, -1, "/u", 0, true, "keep", "", "", "")
    d := add(mut m, top, "Caches", 0, true, "safe", "", "caches", "")
    a := add(mut m, d, "big.mov", 200 * MB, false, "safe", "", "caches", "")
    b := add(mut m, top, "old.zip", 5 * MB, false, "keep", "", "", "")
    m.entries[a].kind = "video"
    m.entries[a].days = 3
    m.entries[b].kind = "archives"
    m.entries[b].days = 900
    finish(mut m)
    eff := sizes(m, {})
    assert_eq(rows(m, 0, "big", eff), [a])
    assert_eq(rows(m, 0, "old", eff), [b])
    assert_eq(rows(m, 0, "kind:video", eff), [a])
    assert_eq(rows(m, 0, "find:CACHE", eff), [d])
    assert_eq(rows(m, 0, "find:.mov", eff), [a])
