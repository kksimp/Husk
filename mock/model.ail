## mock: the scanned tree Husk shows. This is a MOCK with a fixed Mac-like tree
## until the core lane's real model (scan + cleanup rules) lands; the shapes
## here (flat `Entry` list, parent before children, `safety` + `reason`) are
## what the GUI needs from it.

use kinds

## One file or folder. `safety` is `safe` (can be deleted, regenerates),
## `review` (probably fine, look first) or `keep` (don't delete).
pub struct Entry
    pub name str
    pub size int
    pub is_dir bool
    pub safety str
    pub reason str
    pub cat str
    pub parent int
    pub kids List[int]
    pub age str
    ## The real path; empty for the mock tree.
    pub path str
    ## Inside iCloud Drive: removing offloads by default.
    pub icloud bool
    ## Days since a file was modified; -1 for folders and the mock tree.
    pub days int
    ## The file kind (`kinds.of`); "" for folders.
    pub kind str

pub struct Model
    pub entries List[Entry]
    pub vol_total int
    pub vol_used int
    ## Bytes per file kind over the whole scan, not only the entries listed.
    pub kinds List[kinds.Kind]

## The category ids the sidebar lists, with their titles.
pub CATS := [
    ("caches", "Caches"),
    ("logs", "Logs"),
    ("dev", "Developer"),
    ("downloads", "Downloads"),
    ("apps", "Apps"),
    ("media", "Media"),
    ("system", "macOS"),
    ("docs", "Documents"),
]

GB := 1073741824
pub MB := 1048576

pub fn add(
    mut m Model,
    parent int,
    name str,
    size int,
    is_dir bool,
    safety str,
    reason str,
    cat str,
    age str,
) int
    id := m.entries.len()
    m.entries.push(Entry(
        name: name,
        size: size,
        is_dir: is_dir,
        safety: safety,
        reason: reason,
        cat: cat,
        parent: parent,
        kids: [],
        age: age,
        path: "",
        icloud: false,
        days: -1,
        kind: "",
    ))
    if parent >= 0
        m.entries[parent].kids.push(id)
    id

