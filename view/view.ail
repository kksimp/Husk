## view: Husk's whole window as one canvas display list, plus the click regions
## drawn with it. `draw` is pure; `Husk.update` looks a click up in the same
## regions, so what is drawn and what is hit cannot drift apart. The parts live
## in their own modules: state, parts, side, bar, tiles, rows, info, sheets, hello.

use std.app
use state
use look
use side
use bar
use tiles
use rows
use info
use sheets
use hello

## The whole frame for a window of `s.w` by `s.h`.
pub fn draw(s state.State) state.Frame
    mut ops := [app.draw_rect(0.0, 0.0, s.w, s.h, look.BG)]
    mut regs := List[state.Region]()
    if not s.scanned
        hello.welcome(s, mut ops, mut regs)
        side.sidebar(s, mut ops, mut regs)
        return state.Frame(ops: ops, regs: regs)
    ids := s.shown()
    x0 := state.SIDE_W
    foot_y := s.h - state.FOOT_H
    det_y := foot_y - state.DETAIL_H
    tm_y := state.TOOL_H + 12.0
    tm_h := ((det_y - tm_y) * 0.46).max(120.0)
    list_y := tm_y + tm_h + 12.0
    tiles.treemap_view(s, ids, mut ops, mut regs, x0 + 12.0, tm_y, s.w - x0 - 24.0, tm_h)
    rows.list_view(s, ids, mut ops, mut regs, list_y, det_y)
    bar.toolbar(s, mut ops, mut regs)
    side.sidebar(s, mut ops, mut regs)
    info.detail(s, mut ops, det_y)
    info.footer(s, mut ops, mut regs, foot_y)
    if s.sheet
        ops.push(app.Op.Shade(x: 0.0, y: 0.0, w: s.w, h: s.h, color: 0, alpha: 0.45))
    else
        info.tooltip(s, mut ops)
    if s.sheet and not s.admin.is_empty()
        sheets.admin_sheet(s, mut ops, mut regs)
    elif s.sheet
        sheets.sheet(s, mut ops, mut regs)
    state.Frame(ops: ops, regs: regs)

## The region a click at (x, y) landed on; later regions are on top.
pub fn hit(f state.Frame, x float, y float) state.Region?
    mut i := f.regs.len() - 1
    while i >= 0
        r := f.regs[i]
        if x >= r.x and x < r.x + r.w and y >= r.y and y < r.y + r.h
            return r
        i -= 1
    none

## The height of the list's rows area.
pub fn list_height(s state.State) float
    foot_y := s.h - state.FOOT_H
    det_y := foot_y - state.DETAIL_H
    tm_y := state.TOOL_H + 12.0
    tm_h := ((det_y - tm_y) * 0.46).max(120.0)
    det_y - (tm_y + tm_h + 12.0 + state.HEAD_H)

## How far the list can scroll.
pub fn max_scroll(s state.State) float
    (s.shown().len().to_float() * state.ROW_H - list_height(s)).max(0.0)
