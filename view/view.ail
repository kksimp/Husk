## view: Husk's whole window as one canvas display list, plus the click regions
## drawn with it. `draw` is pure; `Husk.update` looks a click up in the same
## regions, so what is drawn and what is hit cannot drift apart.

use std.app
use kinds
use mock
use treemap
use look

## A place Husk can scan: `id` is what a click sends, `detail` says what it finds.
pub struct Target
    pub id str
    pub label str
    pub detail str

## Everything the window needs to remember.
pub struct State
    pub m mock.Model
    pub eff List[int]
    pub gone Set[int]
    pub marks Set[int]
    pub cur int
    pub filter str
    pub sel int
    pub sort_key str
    pub desc bool
    pub top float
    pub sheet bool
    pub undo List[int]
    pub w float
    pub h float
    ## Scan progress 0 to 1; below 1 the toolbar shows a progress bar.
    pub pct float
    pub scan_note str
    ## A line for the footer, such as why a move to the Trash failed.
    pub notice str
    ## False until the first scan finishes: the window then shows the welcome page.
    pub scanned bool
    pub targets List[Target]
    ## The folder field's text.
    pub path str
    ## Also delete iCloud items from iCloud, not just offload them.
    pub cloud_delete bool
    ## Entries that need administrator rights to remove; non-empty shows the admin sheet.
    pub admin List[int]
    ## The tile or row under the pointer (-1: none) and where the pointer entered it.
    pub hover int
    pub hx float
    pub hy float
    ## The pointer's last x, so a scroll over the sidebar scrolls the sidebar.
    pub mx float
    ## How far the sidebar's list is scrolled.
    pub side_top float
    ## The search field's text.
    pub find str

## A rectangle that reacts to a click. `kind` says what; `k` is an entry id or
## index, `arg` a filter or sort key.
pub struct Region
    pub x float
    pub y float
    pub w float
    pub h float
    pub kind str
    pub k int
    pub arg str

pub struct Frame
    pub ops List[app.Op]
    pub regs List[Region]

pub SIDE_W := 220.0
pub TOOL_H := 48.0
pub ROW_H := 30.0
HEAD_H := 26.0
DETAIL_H := 68.0
FOOT_H := 54.0

pub fn State.new(m mock.Model) State
    State(
        m: m,
        eff: mock.sizes(m, {}),
        gone: {},
        marks: {},
        cur: 0,
        filter: "",
        sel: -1,
        sort_key: "size",
        desc: true,
        top: 0.0,
        sheet: false,
        undo: [],
        w: 1100.0,
        h: 720.0,
        pct: 1.0,
        scan_note: "",
        notice: "",
        scanned: false,
        targets: [],
        path: "",
        cloud_delete: false,
        admin: [],
        hover: -1,
        hx: 0.0,
        hy: 0.0,
        mx: 0.0,
        side_top: 0.0,
        find: "",
    )

## The ids the list and treemap show, in the order the user sorted them.
pub fn State.shown(self) List[int]
    ids := mock.rows(m, cur, filter, eff)
    mut keys := List[int]()
    if sort_key == "name"
        mut names := List[str]()
        for i in ids
            names.push(m.entries[i].name.to_lower())
        ranked := names.sorted()
        for n in names
            keys.push(ranked.index_of(n) else 0)
    else
        for i in ids
            big := FAR - eff[i].min(FAR - 1)
            keys.push(if sort_key == "safety" then rank(m.entries[i].safety) * FAR + big else big)
    by := order(keys, ids)
    if (sort_key == "size" and not desc)
        or (sort_key == "safety" and desc)
        or (sort_key == "name" and desc)
        return flip(by)
    by

## Bytes (and ranks) are packed below this so `order` can sort plain ints.
FAR := 1099511627776
SLOT := 1048576

## `ids` sorted by `keys` (each below 2^42), ties by id; both lists line up.
fn order(keys List[int], ids List[int]) List[int]
    mut packed := List[int]()
    for n in 0..ids.len()
        packed.push(keys[n] * SLOT + ids[n])
    mut out := List[int]()
    for c in packed.sorted()
        out.push(c % SLOT)
    out

fn flip(xs List[int]) List[int]
    mut out := List[int]()
    mut i := xs.len() - 1
    while i >= 0
        out.push(xs[i])
        i -= 1
    out

fn rank(s str) int
    if s == "safe"
        return 0
    if s == "review"
        return 1
    2

## Total bytes the marks would free.
pub fn State.reclaim(self) int
    mut t := 0
    for id in mock.top_marks(m, marks)
        t += eff[id]
    t

fn State.title(self) str
    if filter == ""
        return m.entries[cur].name
    if filter == "safe"
        return "Safe to delete"
    if filter == "big"
        return "Large files (over {mock.fmt_size(mock.BIG)})"
    if filter == "old"
        return "Old files (not changed for a year)"
    if filter == "dupes"
        return "Duplicates: extra copies of identical files"
    if k := filter.strip_prefix("kind:")
        return kinds.name(k)
    if q := filter.strip_prefix("find:")
        return "Names containing “{q}”"
    for c in mock.CATS
        if c.0 == filter
            return c.1
    filter

fn rect(mut ops List[app.Op], x float, y float, w float, h float, c int)
    ops.push(app.draw_rect(x, y, w, h, c))

fn reg(mut regs List[Region], x float, y float, w float, h float, kind str, k int, arg str)
    regs.push(Region(x: x, y: y, w: w, h: h, kind: kind, k: k, arg: arg))

fn badge(mut ops List[app.Op], x float, y float, safety str, bg int)
    c := look.safety_color(safety)
    look.round(mut ops, x, y, 56.0, 20.0, 10.0, look.mix(bg, c, 0.22), bg)
    ops.push(look.text(
        x + 28.0 - look.width(look.safety_label(safety), 11.0) / 2.0,
        y + 4.0,
        look.safety_label(safety),
        c,
        11.0,
        true,
    ))

fn button(
    mut ops List[app.Op],
    mut regs List[Region],
    x float,
    y float,
    w float,
    label str,
    primary bool,
    bg int,
    kind str,
)
    face := if primary then look.ACCENT else look.mix(bg, 0xffffff, 0.1)
    look.round(mut ops, x, y, w, 28.0, 7.0, face, bg)
    ops.push(look.text(
        x + w / 2.0 - look.width(label, 12.0) / 2.0,
        y + 7.0,
        label,
        0xffffff,
        12.0,
        primary,
    ))
    reg(mut regs, x, y, w, 28.0, kind, 0, "")

fn check(mut ops List[app.Op], x float, y float, on bool, bg int)
    if on
        look.round(mut ops, x, y, 15.0, 15.0, 4.0, look.ACCENT, bg)
        ops.push(look.text(x + 3.0, y + 1.0, "✓", 0xffffff, 11.0, true))
    else
        look.round(mut ops, x, y, 15.0, 15.0, 4.0, look.DIM, bg)
        look.round(mut ops, x + 1.0, y + 1.0, 13.0, 13.0, 3.0, bg, look.DIM)

## The sidebar: title, the volume bar, and what to look at.
fn sidebar(s State, mut ops List[app.Op], mut regs List[Region])
    rect(mut ops, 0.0, 0.0, SIDE_W, s.h, look.SIDE)
    rect(mut ops, SIDE_W - 1.0, 0.0, 1.0, s.h, look.LINE)
    ops.push(look.text(20.0, 18.0, "Husk", look.TEXT, 20.0, true))
    ops.push(look.text(20.0, 44.0, "What is using your disk", look.DIM, 11.0, false))
    if not s.scanned
        sidebar_targets(s, mut ops, mut regs)
        return
    # The volume card.
    ops.push(look.text(20.0, 82.0, "Macintosh HD", look.TEXT, 12.0, true))
    bw := SIDE_W - 40.0
    if s.m.vol_total <= 0
        # No volume numbers (fs.volume, ADR 0928): show what the scan found.
        ops.push(look.text(
            20.0,
            104.0,
            "{mock.fmt_size(s.eff[0])} scanned",
            look.TEXT,
            12.0,
            false,
        ))
        if s.reclaim() > 0
            ops.push(look.text(
                20.0,
                124.0,
                "{mock.fmt_size(s.reclaim())} can be freed",
                look.SAFE,
                11.0,
                false,
            ))
        sidebar_nav(s, mut ops, mut regs)
        sidebar_targets(s, mut ops, mut regs)
        return
    look.round(mut ops, 20.0, 104.0, bw, 8.0, 4.0, look.mix(look.SIDE, 0xffffff, 0.12), look.SIDE)
    used := s.m.vol_used.to_float() / s.m.vol_total.to_float()
    uw := bw * used
    look.round(mut ops, 20.0, 104.0, uw, 8.0, 4.0, look.ACCENT, look.SIDE)
    rec := (s.reclaim().to_float() / s.m.vol_total.to_float() * bw).min(uw)
    if rec > 2.0
        look.round(mut ops, 20.0 + uw - rec, 104.0, rec, 8.0, 4.0, look.SAFE, look.SIDE)
    free := s.m.vol_total - s.m.vol_used
    ops.push(look.text(
        20.0,
        120.0,
        "{mock.fmt_size(s.m.vol_used)} of {mock.fmt_size(s.m.vol_total)} used",
        look.DIM,
        11.0,
        false,
    ))
    ops.push(look.text(20.0, 136.0, "{mock.fmt_size(free)} free", look.TEXT, 11.0, false))
    if s.reclaim() > 0
        ops.push(look.text(
            20.0,
            152.0,
            "{mock.fmt_size(free + s.reclaim())} free after cleanup",
            look.SAFE,
            11.0,
            false,
        ))
    sidebar_nav(s, mut ops, mut regs)
    sidebar_targets(s, mut ops, mut regs)

## "Scan" entries pinned to the bottom of the sidebar.
fn sidebar_targets(s State, mut ops List[app.Op], mut regs List[Region])
    mut y := s.h - 30.0 * s.targets.len().to_float() - 34.0
    rect(mut ops, 10.0, y - 8.0, SIDE_W - 20.0, 1.0, look.LINE)
    ops.push(look.text(20.0, y + 4.0, "SCAN", look.DIM, 10.0, true))
    y += 24.0
    for t in s.targets
        ops.push(look.text(22.0, y + 7.0, t.label, 0xd1d1d6, 12.0, false))
        reg(mut regs, 10.0, y, SIDE_W - 20.0, 28.0, "target", 0, t.id)
        y += 30.0

## One line of the sidebar list: a heading (`id` empty, no size) or a view.
pub struct NavItem
    pub id str
    pub name str
    pub size str
    pub head bool

fn nav(id str, name str, size int) NavItem
    NavItem(id: id, name: name, size: mock.fmt_size(size), head: false)

fn head(name str) NavItem
    NavItem(id: "", name: name, size: "", head: true)

## What the sidebar lists: the overview, categories, finders and file kinds that have something.
pub fn nav_items(s State) List[NavItem]
    mut out := [nav("", "Overview", s.eff[0]), nav(
        "safe",
        "Safe to delete",
        mock.filter_total(s.m, "safe", s.eff),
    )]
    mut cats := List[NavItem]()
    for c in mock.CATS
        total := mock.filter_total(s.m, c.0, s.eff)
        if total > 0
            cats.push(nav(c.0, c.1, total))
    if not cats.is_empty()
        out.push(head("CATEGORIES"))
        out.extend(cats)
    big := mock.filter_total(s.m, "big", s.eff)
    old := mock.filter_total(s.m, "old", s.eff)
    out.push(head("FIND"))
    if big > 0
        out.push(nav("big", "Large files", big))
    if old > 0
        out.push(nav("old", "Old files", old))
    if s.m.dupes_done
        out.push(nav("dupes", "Duplicates", mock.filter_total(s.m, "dupes", s.eff)))
    else
        out.push(NavItem(id: "dupes", name: "Duplicates", size: "Find…", head: false))
    if not s.m.kinds.is_empty()
        out.push(head("FILE TYPES"))
        for k in s.m.kinds
            out.push(nav("kind:{k.id}", k.name, k.bytes))
    out

NAV_Y := 176.0
NAV_H := 26.0
HEAD_ROW := 28.0

## Where the sidebar list must end: above the Scan entries.
fn nav_bottom(s State) float
    s.h - 30.0 * s.targets.len().to_float() - 50.0

## How far the sidebar list can scroll.
pub fn side_max(s State) float
    mut h := 0.0
    for it in nav_items(s)
        h += if it.head then HEAD_ROW else NAV_H
    (NAV_Y + h - nav_bottom(s)).max(0.0)

fn sidebar_nav(s State, mut ops List[app.Op], mut regs List[Region])
    bottom := nav_bottom(s)
    ops.push(app.Op.Clip(x: 0.0, y: NAV_Y, w: SIDE_W - 1.0, h: (bottom - NAV_Y).max(0.0)))
    mut y := NAV_Y - s.side_top
    for it in nav_items(s)
        if it.head
            ops.push(look.text(20.0, y + 12.0, it.name, look.DIM, 10.0, true))
            y += HEAD_ROW
            continue
        if y + NAV_H > NAV_Y and y < bottom
            nav_row(s, mut ops, mut regs, y, it, bottom)
        y += NAV_H
    ops.push(app.Op.Unclip)

fn nav_row(s State, mut ops List[app.Op], mut regs List[Region], y float, it NavItem, bottom float)
    on := s.filter == it.id
    if on
        look.round(
            mut ops,
            10.0,
            y,
            SIDE_W - 20.0,
            NAV_H - 2.0,
            7.0,
            look.mix(look.SIDE, look.ACCENT, 0.4),
            look.SIDE,
        )
    ops.push(look.text(
        22.0,
        y + 5.0,
        look.fit(it.name, SIDE_W - 110.0, 12.0),
        if on then look.TEXT else 0xd1d1d6,
        12.0,
        on,
    ))
    ops.push(look.text(
        SIDE_W - 20.0 - look.width(it.size, 11.0),
        y + 6.0,
        it.size,
        look.DIM,
        11.0,
        false,
    ))
    top := y.max(NAV_Y)
    reg(mut regs, 10.0, top, SIDE_W - 20.0, (y + NAV_H - 2.0).min(bottom) - top, "nav", 0, it.id)

## The toolbar: breadcrumb (or the view's name) on the left, scan state on the right.
fn toolbar(s State, mut ops List[app.Op], mut regs List[Region])
    x0 := SIDE_W
    rect(mut ops, x0, 0.0, s.w - x0, TOOL_H, look.PANEL)
    rect(mut ops, x0, TOOL_H - 1.0, s.w - x0, 1.0, look.LINE)
    mut x := x0 + 16.0
    if s.filter == ""
        trail := mock.trail(s.m, s.cur)
        for i, id in trail.enumerate()
            last := i == trail.len() - 1
            name := s.m.entries[id].name
            ops.push(look.text(x, 16.0, name, if last then look.TEXT else look.DIM, 13.0, last))
            w := look.width(name, 13.0)
            if not last
                reg(mut regs, x - 4.0, 8.0, w + 8.0, 32.0, "crumb", id, "")
                ops.push(look.text(x + w + 6.0, 16.0, "›", look.DIM, 13.0, false))
            x += w + 24.0
    else
        ops.push(look.text(x, 16.0, s.title(), look.TEXT, 13.0, true))
    if s.pct < 1.0
        pw := 160.0
        px := s.w - pw - 20.0
        look.round(
            mut ops,
            px,
            21.0,
            pw,
            6.0,
            3.0,
            look.mix(look.PANEL, 0xffffff, 0.14),
            look.PANEL,
        )
        look.round(mut ops, px, 21.0, (pw * s.pct).max(6.0), 6.0, 3.0, look.ACCENT, look.PANEL)
        ops.push(look.text(
            px - 12.0 - look.width(look.fit(s.scan_note, 260.0, 11.0), 11.0),
            17.0,
            look.fit(s.scan_note, 260.0, 11.0),
            look.DIM,
            11.0,
            false,
        ))
    else
        button(mut ops, mut regs, s.w - 96.0, 10.0, 80.0, "Rescan", false, look.PANEL, "rescan")

## The treemap: one tile per shown entry, colored by how safe it is to delete.
fn treemap_view(
    s State,
    ids List[int],
    mut ops List[app.Op],
    mut regs List[Region],
    x float,
    y float,
    w float,
    h float,
)
    rect(mut ops, x, y, w, h, look.BG)
    if ids.is_empty()
        ops.push(look.text(
            x + w / 2.0 - 60.0,
            y + h / 2.0 - 8.0,
            "Nothing here",
            look.DIM,
            13.0,
            false,
        ))
        return
    ranked := s.sorted_by_size(ids)
    boxes := treemap.layout([s.eff[i] for i in ranked], x, y, w, h)
    for n, b in boxes.enumerate()
        id := ranked[n]
        e := s.m.entries[id]
        c := look.safety_color(e.safety)
        shade := 0.34 + 0.05 * (n % 3).to_float()
        rect(
            mut ops,
            b.x + 1.0,
            b.y + 1.0,
            (b.w - 2.0).max(1.0),
            (b.h - 2.0).max(1.0),
            look.mix(look.BG, c, shade),
        )
        if id == s.sel
            for edge in [
                (0.0, 0.0, b.w, 2.0),
                (0.0, b.h - 2.0, b.w, 2.0),
                (0.0, 0.0, 2.0, b.h),
                (b.w - 2.0, 0.0, 2.0, b.h),
            ]
                rect(mut ops, b.x + edge.0, b.y + edge.1, edge.2, edge.3, 0xffffff)
        if s.marks.contains(id)
            ops.push(look.text(b.x + b.w - 20.0, b.y + 6.0, "✓", 0xffffff, 13.0, true))
        if b.w > 76.0 and b.h > 38.0
            ops.push(look.text(
                b.x + 10.0,
                b.y + 8.0,
                look.fit(e.name, b.w - 36.0, 12.0),
                0xffffff,
                12.0,
                true,
            ))
            ops.push(look.text(
                b.x + 10.0,
                b.y + 25.0,
                mock.fmt_size(s.eff[id]),
                look.mix(0xffffff, c, 0.2),
                11.0,
                false,
            ))
        reg(mut regs, b.x, b.y, b.w, b.h, "tile", id, "")

## Ids by size, largest first, for the treemap.
fn State.sorted_by_size(self, ids List[int]) List[int]
    mut keys := List[int]()
    for i in ids
        keys.push(FAR - eff[i].min(FAR - 1))
    order(keys, ids)

## The sortable list under the treemap.
fn list_view(
    s State,
    ids List[int],
    mut ops List[app.Op],
    mut regs List[Region],
    y float,
    bottom float,
)
    x0 := SIDE_W
    avail := s.w - x0
    cx := x0 + 16.0
    nx := x0 + 44.0
    nw := (avail * 0.26).max(150.0)
    sx := nx + nw
    bx := sx + 82.0
    gx := bx + 120.0
    rx := gx + 72.0
    rect(mut ops, x0, y, avail, HEAD_H, look.PANEL)
    for h in [("name", "Name", nx), ("size", "Size", sx), ("safety", "Safety", gx)]
        arrow := sort_arrow(s, h.0)
        ops.push(look.text(
            h.2,
            y + 7.0,
            "{h.1}{arrow}",
            if s.sort_key == h.0 then look.TEXT else look.DIM,
            11.0,
            true,
        ))
        reg(mut regs, h.2 - 6.0, y, 90.0, HEAD_H, "sort", 0, h.0)
    ops.push(look.text(rx, y + 7.0, "Why", look.DIM, 11.0, true))
    top := y + HEAD_H
    rect(mut ops, x0, top, avail, bottom - top, look.BG)
    ops.push(app.Op.Clip(x: x0, y: top, w: avail, h: bottom - top))
    mut big := 1
    for i in ids
        big = big.max(s.eff[i])
    biggest := big.to_float()
    for n, id in ids.enumerate()
        ry := top + n.to_float() * ROW_H - s.top
        if ry + ROW_H < top or ry > bottom
            continue
        e := s.m.entries[id]
        mut bg := look.BG
        if n % 2 == 1
            bg = look.mix(look.BG, 0xffffff, 0.03)
        if id == s.sel
            bg = look.mix(look.BG, look.ACCENT, 0.35)
        rect(mut ops, x0, ry, avail, ROW_H, bg)
        check(mut ops, cx, ry + 7.0, s.marks.contains(id), bg)
        vis := (bottom - ry).min(ROW_H)
        reg(mut regs, cx - 6.0, ry.max(top), 30.0, vis, "check", id, "")
        mark := if e.is_dir then "▸ " else ""
        ops.push(look.text(
            nx,
            ry + 8.0,
            look.fit("{mark}{e.name}", nw - 8.0, 12.0),
            look.TEXT,
            12.0,
            false,
        ))
        ops.push(look.text(sx, ry + 8.0, mock.fmt_size(s.eff[id]), look.DIM, 12.0, false))
        c := look.safety_color(e.safety)
        look.round(
            mut ops,
            bx,
            ry + 11.0,
            (104.0 * s.eff[id].to_float() / biggest).max(3.0),
            8.0,
            3.0,
            look.mix(bg, c, 0.7),
            bg,
        )
        badge(mut ops, gx, ry + 5.0, e.safety, bg)
        ops.push(look.text(
            rx,
            ry + 8.0,
            look.fit(e.reason, s.w - rx - 16.0, 12.0),
            look.DIM,
            12.0,
            false,
        ))
        reg(mut regs, nx - 4.0, ry.max(top), s.w - nx, vis, "row", id, "")
    ops.push(app.Op.Unclip)

fn sort_arrow(s State, key str) str
    if s.sort_key != key
        return ""
    if s.desc
        return " ▾"
    " ▴"

## What Husk knows about the selected entry.
fn detail(s State, mut ops List[app.Op], y float)
    x0 := SIDE_W
    rect(mut ops, x0, y, s.w - x0, DETAIL_H, look.PANEL)
    rect(mut ops, x0, y, s.w - x0, 1.0, look.LINE)
    if s.sel < 0
        ops.push(look.text(
            x0 + 16.0,
            y + 24.0,
            "Select an item to see why Husk suggests keeping or deleting it.",
            look.DIM,
            12.0,
            false,
        ))
        return
    e := s.m.entries[s.sel]
    mut names := List[str]()
    for i in mock.trail(s.m, s.sel)
        names.push(s.m.entries[i].name)
    path := names.join(" / ")
    ops.push(look.text(x0 + 16.0, y + 10.0, e.name, look.TEXT, 13.0, true))
    badge(mut ops, x0 + 24.0 + look.width(e.name, 13.0), y + 8.0, e.safety, look.PANEL)
    ops.push(look.text(
        x0 + 16.0,
        y + 30.0,
        look.fit(e.reason, s.w - x0 - 32.0, 12.0),
        look.TEXT,
        12.0,
        false,
    ))
    age := if e.age == "" then "" else " · last used {e.age}"
    ops.push(look.text(
        x0 + 16.0,
        y + 48.0,
        look.fit("{mock.fmt_size(s.eff[s.sel])}{age} · {path}", s.w - x0 - 32.0, 11.0),
        look.DIM,
        11.0,
        false,
    ))

## The bottom bar: what is selected, or the undo for the last trash.
fn footer(s State, mut ops List[app.Op], mut regs List[Region], y float)
    x0 := SIDE_W
    rect(mut ops, x0, y, s.w - x0, FOOT_H, look.SIDE)
    rect(mut ops, x0, y, s.w - x0, 1.0, look.LINE)
    n := mock.top_marks(s.m, s.marks).len()
    if not s.undo.is_empty()
        ops.push(look.text(
            x0 + 16.0,
            y + 19.0,
            "Moved {s.undo.len()} items to the Trash",
            look.SAFE,
            12.0,
            true,
        ))
        button(mut ops, mut regs, x0 + 220.0, y + 13.0, 70.0, "Undo", false, look.SIDE, "undo")
    elif s.notice != ""
        ops.push(look.text(
            x0 + 16.0,
            y + 19.0,
            look.fit(s.notice, s.w - x0 - 380.0, 12.0),
            look.REVIEW,
            12.0,
            true,
        ))
    elif n > 0
        ops.push(look.text(
            x0 + 16.0,
            y + 19.0,
            "{n} selected · {mock.fmt_size(s.reclaim())} can be freed",
            look.TEXT,
            12.0,
            true,
        ))
    else
        ops.push(look.text(
            x0 + 16.0,
            y + 19.0,
            "Tick items to clear them out; right-click one for more. Nothing is deleted until you confirm.",
            look.DIM,
            12.0,
            false,
        ))
    button(
        mut ops,
        mut regs,
        s.w - 332.0,
        y + 13.0,
        120.0,
        "Select all safe",
        false,
        look.SIDE,
        "all_safe",
    )
    button(
        mut ops,
        mut regs,
        s.w - 202.0,
        y + 13.0,
        186.0,
        "Review & Move to Trash…",
        n > 0,
        look.SIDE,
        "review",
    )

## The confirmation sheet: exactly what goes to the Trash.
fn sheet(s State, mut ops List[app.Op], mut regs List[Region])
    reg(mut regs, 0.0, 0.0, s.w, s.h, "scrim", 0, "")
    top := mock.top_marks(s.m, s.marks)
    shown := top.take(8)
    pw := (s.w - 60.0).min(560.0)
    mut cloud := 0
    for id in top
        if s.m.entries[id].icloud
            cloud += 1
    ph := 190.0 + shown.len().to_float() * 30.0 + (if cloud > 0 then 64.0 else 0.0)
    px := (s.w - pw) / 2.0
    py := ((s.h - ph) / 2.0).max(20.0)
    look.round(mut ops, px - 1.0, py - 1.0, pw + 2.0, ph + 2.0, 13.0, look.LINE, look.BG)
    look.round(mut ops, px, py, pw, ph, 12.0, look.PANEL, look.LINE)
    ops.push(look.text(
        px + 24.0,
        py + 20.0,
        "Move {top.len()} items to the Trash?",
        look.TEXT,
        16.0,
        true,
    ))
    ops.push(look.text(
        px + 24.0,
        py + 46.0,
        "Frees {mock.fmt_size(s.reclaim())}. They stay in the Trash until you empty it, and Undo puts them back.",
        look.DIM,
        11.0,
        false,
    ))
    mut risky := 0
    for n, id in shown.enumerate()
        ry := py + 74.0 + n.to_float() * 30.0
        e := s.m.entries[id]
        if e.safety != "safe"
            risky += 1
        ops.push(look.text(
            px + 24.0,
            ry + 7.0,
            look.fit(e.name, pw - 220.0, 12.0),
            look.TEXT,
            12.0,
            false,
        ))
        badge(mut ops, px + pw - 170.0, ry + 4.0, e.safety, look.PANEL)
        sz := mock.fmt_size(s.eff[id])
        ops.push(look.text(
            px + pw - 24.0 - look.width(sz, 12.0),
            ry + 7.0,
            sz,
            look.DIM,
            12.0,
            false,
        ))
    if top.len() > shown.len()
        ops.push(look.text(
            px + 24.0,
            py + 74.0 + shown.len().to_float() * 30.0 + 6.0,
            "and {top.len() - shown.len()} more",
            look.DIM,
            11.0,
            false,
        ))
    for id in top
        if s.m.entries[id].safety != "safe" and not shown.contains(id)
            risky += 1
    by := py + ph - 52.0
    if risky > 0
        ops.push(look.text(
            px + 24.0,
            by - 4.0,
            "{risky} of these are not marked Safe. Check them before you go on.",
            look.REVIEW,
            11.0,
            false,
        ))
    if cloud > 0
        cy := by - 70.0
        ops.push(look.text(
            px + 24.0,
            cy,
            look.fit(
                "{cloud} in iCloud Drive: only the copy on this Mac is removed. They stay in iCloud.",
                pw - 48.0,
                11.0,
            ),
            look.SAFE,
            11.0,
            false,
        ))
        check(mut ops, px + 24.0, cy + 22.0, s.cloud_delete, look.PANEL)
        ops.push(look.text(
            px + 48.0,
            cy + 22.0,
            look.fit(
                "Also delete them from iCloud (they vanish on all your devices)",
                pw - 72.0,
                11.0,
            ),
            if s.cloud_delete then look.KEEP else look.DIM,
            11.0,
            false,
        ))
        reg(mut regs, px + 20.0, cy + 18.0, pw - 40.0, 24.0, "cloudbox", 0, "")
    button(
        mut ops,
        mut regs,
        px + pw - 24.0 - 170.0 - 10.0 - 80.0,
        by + 8.0,
        80.0,
        "Cancel",
        false,
        look.PANEL,
        "cancel",
    )
    button(
        mut ops,
        mut regs,
        px + pw - 24.0 - 170.0,
        by + 8.0,
        170.0,
        "Move to Trash",
        true,
        look.PANEL,
        "trash",
    )

## Asks before deleting what the user's account can't: macOS shows its own password prompt.
fn admin_sheet(s State, mut ops List[app.Op], mut regs List[Region])
    reg(mut regs, 0.0, 0.0, s.w, s.h, "scrim", 0, "")
    pw := (s.w - 60.0).min(520.0)
    shown := s.admin.take(4)
    ph := 190.0 + shown.len().to_float() * 22.0
    px := (s.w - pw) / 2.0
    py := ((s.h - ph) / 2.0).max(20.0)
    look.round(mut ops, px - 1.0, py - 1.0, pw + 2.0, ph + 2.0, 13.0, look.LINE, look.BG)
    look.round(mut ops, px, py, pw, ph, 12.0, look.PANEL, look.LINE)
    ops.push(look.text(
        px + 24.0,
        py + 20.0,
        "Administrator permission needed",
        look.TEXT,
        16.0,
        true,
    ))
    ops.push(look.text(
        px + 24.0,
        py + 46.0,
        look.fit(
            "{s.admin.len()} items belong to the system or another user, so your account can't remove them.",
            pw - 48.0,
            11.0,
        ),
        look.DIM,
        11.0,
        false,
    ))
    ops.push(look.text(
        px + 24.0,
        py + 64.0,
        look.fit(
            "macOS asks for your password. They are deleted for good, not moved to the Trash.",
            pw - 48.0,
            11.0,
        ),
        look.REVIEW,
        11.0,
        false,
    ))
    for n, id in shown.enumerate()
        ops.push(look.text(
            px + 24.0,
            py + 90.0 + n.to_float() * 22.0,
            look.fit(s.m.entries[id].path, pw - 48.0, 12.0),
            look.TEXT,
            12.0,
            false,
        ))
    by := py + ph - 52.0
    button(
        mut ops,
        mut regs,
        px + pw - 24.0 - 170.0 - 10.0 - 80.0,
        by + 8.0,
        80.0,
        "Cancel",
        false,
        look.PANEL,
        "cancel",
    )
    button(
        mut ops,
        mut regs,
        px + pw - 24.0 - 170.0,
        by + 8.0,
        170.0,
        "Allow with password",
        true,
        look.PANEL,
        "admin_go",
    )

## The card under the pointer: name, size, safety, age and kind of the hovered tile or row.
fn tooltip(s State, mut ops List[app.Op])
    if s.hover < 0 or s.hover >= s.m.entries.len()
        return
    e := s.m.entries[s.hover]
    mut facts := [mock.fmt_size(s.eff[s.hover]), look.safety_label(e.safety)]
    if e.age != ""
        facts.push("changed {e.age}")
    if e.kind != ""
        facts.push(kinds.name(e.kind))
    line := facts.join(" · ")
    tw := 320.0
    th := 66.0
    x := (s.hx + 14.0).min(s.w - tw - 8.0).max(8.0)
    y := if s.hy + 18.0 + th > s.h then s.hy - th - 8.0 else s.hy + 18.0
    look.round(mut ops, x - 1.0, y - 1.0, tw + 2.0, th + 2.0, 9.0, look.LINE, look.BG)
    look.round(mut ops, x, y, tw, th, 8.0, look.mix(look.PANEL, 0xffffff, 0.06), look.LINE)
    ops.push(look.text(x + 12.0, y + 9.0, look.fit(e.name, tw - 24.0, 12.0), look.TEXT, 12.0, true))
    ops.push(look.text(
        x + 12.0,
        y + 27.0,
        look.fit(line, tw - 24.0, 11.0),
        look.safety_color(e.safety),
        11.0,
        false,
    ))
    ops.push(look.text(
        x + 12.0,
        y + 44.0,
        look.fit(e.reason, tw - 24.0, 11.0),
        look.DIM,
        11.0,
        false,
    ))

## The whole frame for a window of `s.w` by `s.h`.
## The first screen: pick what to scan.
fn welcome(s State, mut ops List[app.Op], mut regs List[Region])
    x0 := SIDE_W + 40.0
    ops.push(look.text(x0, 90.0, "What is using your disk?", look.TEXT, 24.0, true))
    scanning := s.pct < 1.0
    if scanning
        ops.push(look.text(x0, 130.0, "Scanning…", look.ACCENT, 14.0, true))
        ops.push(look.text(
            x0,
            154.0,
            look.fit(s.scan_note, s.w - x0 - 40.0, 12.0),
            look.DIM,
            12.0,
            false,
        ))
        ops.push(look.text(
            x0,
            178.0,
            "Big folders take a minute. The window fills in when the scan is done.",
            look.DIM,
            12.0,
            false,
        ))
        return
    ops.push(look.text(
        x0,
        126.0,
        "Pick a place to scan. Husk sizes everything in it and says what is safe to delete.",
        look.DIM,
        13.0,
        false,
    ))
    if s.notice != ""
        ops.push(look.text(
            x0,
            150.0,
            look.fit(s.notice, s.w - x0 - 40.0, 12.0),
            look.REVIEW,
            12.0,
            true,
        ))
    mut y := 184.0
    cw := (s.w - x0 - 40.0).min(620.0)
    for n, t in s.targets.enumerate()
        look.round(
            mut ops,
            x0,
            y,
            cw,
            58.0,
            10.0,
            if n == 0 then look.mix(look.BG, look.ACCENT, 0.3) else look.PANEL,
            look.BG,
        )
        ops.push(look.text(x0 + 18.0, y + 10.0, t.label, look.TEXT, 14.0, true))
        ops.push(look.text(
            x0 + 18.0,
            y + 32.0,
            look.fit(t.detail, cw - 36.0, 12.0),
            look.DIM,
            12.0,
            false,
        ))
        reg(mut regs, x0, y, cw, 58.0, "target", 0, t.id)
        y += 68.0
    ops.push(look.text(
        x0,
        y + 8.0,
        "Or type a folder above and press Return.",
        look.DIM,
        12.0,
        false,
    ))

pub fn draw(s State) Frame
    mut ops := [app.draw_rect(0.0, 0.0, s.w, s.h, look.BG)]
    mut regs := List[Region]()
    if not s.scanned
        welcome(s, mut ops, mut regs)
        sidebar(s, mut ops, mut regs)
        return Frame(ops: ops, regs: regs)
    ids := s.shown()
    x0 := SIDE_W
    foot_y := s.h - FOOT_H
    det_y := foot_y - DETAIL_H
    tm_y := TOOL_H + 12.0
    tm_h := ((det_y - tm_y) * 0.46).max(120.0)
    list_y := tm_y + tm_h + 12.0
    treemap_view(s, ids, mut ops, mut regs, x0 + 12.0, tm_y, s.w - x0 - 24.0, tm_h)
    list_view(s, ids, mut ops, mut regs, list_y, det_y)
    toolbar(s, mut ops, mut regs)
    sidebar(s, mut ops, mut regs)
    detail(s, mut ops, det_y)
    footer(s, mut ops, mut regs, foot_y)
    if s.sheet
        ops.push(app.Op.Shade(x: 0.0, y: 0.0, w: s.w, h: s.h, color: 0, alpha: 0.45))
    else
        tooltip(s, mut ops)
    if s.sheet and not s.admin.is_empty()
        admin_sheet(s, mut ops, mut regs)
    elif s.sheet
        sheet(s, mut ops, mut regs)
    Frame(ops: ops, regs: regs)

## The region a click at (x, y) landed on; later regions are on top.
pub fn hit(f Frame, x float, y float) Region?
    mut i := f.regs.len() - 1
    while i >= 0
        r := f.regs[i]
        if x >= r.x and x < r.x + r.w and y >= r.y and y < r.y + r.h
            return r
        i -= 1
    none

## The height of the list's rows area.
pub fn list_height(s State) float
    foot_y := s.h - FOOT_H
    det_y := foot_y - DETAIL_H
    tm_y := TOOL_H + 12.0
    tm_h := ((det_y - tm_y) * 0.46).max(120.0)
    det_y - (tm_y + tm_h + 12.0 + HEAD_H)

## How far the list can scroll.
pub fn max_scroll(s State) float
    (s.shown().len().to_float() * ROW_H - list_height(s)).max(0.0)
