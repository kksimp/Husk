## hello: the welcome page.

use std.app
use state
use parts
use look

pub fn welcome(s state.State, mut ops List[app.Op], mut regs List[state.Region])
    x0 := state.SIDE_W + 40.0
    ops.push(look.text(x0, 90.0, "What is using your disk?", look.TEXT, 24.0, true))
    scanning := s.pct < 1.0
    if scanning
        ops.push(look.text(x0, 130.0, "Scanning…", look.ACCENT, 14.0, true))
        ops.push(look.text(
            x0,
            154.0,
            look.fit(s.scan_note, s.w - x0 - 40.0, 12.0),
            look.DIM,
            12.0,
            false,
        ))
        ops.push(look.text(
            x0,
            178.0,
            "Big folders take a minute. The window fills in when the scan is done.",
            look.DIM,
            12.0,
            false,
        ))
        return
    ops.push(look.text(
        x0,
        126.0,
        "Pick a place to scan. Husk sizes everything in it and says what is safe to delete.",
        look.DIM,
        13.0,
        false,
    ))
    if s.notice != ""
        ops.push(look.text(
            x0,
            150.0,
            look.fit(s.notice, s.w - x0 - 40.0, 12.0),
            look.REVIEW,
            12.0,
            true,
        ))
    mut y := 184.0
    cw := (s.w - x0 - 40.0).min(620.0)
    for n, t in s.targets.enumerate()
        look.round(
            mut ops,
            x0,
            y,
            cw,
            58.0,
            10.0,
            if n == 0 then look.mix(look.BG, look.ACCENT, 0.3) else look.PANEL,
            look.BG,
        )
        ops.push(look.text(x0 + 18.0, y + 10.0, t.label, look.TEXT, 14.0, true))
        ops.push(look.text(
            x0 + 18.0,
            y + 32.0,
            look.fit(t.detail, cw - 36.0, 12.0),
            look.DIM,
            12.0,
            false,
        ))
        parts.reg(mut regs, x0, y, cw, 58.0, "target", 0, t.id)
        y += 68.0
    ops.push(look.text(
        x0,
        y + 8.0,
        "Or type a folder above and press Return.",
        look.DIM,
        12.0,
        false,
    ))
