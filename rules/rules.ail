## Husk's rules: data, not code. Each Rule says "paths like this are SAFE,
## PROBABLY_SAFE or KEEP, because ...". `rate` picks the most specific rule that
## fits and returns its Verdict. Nothing here touches the disk: callers pass the
## set of known file paths (`markers`) so project markers like package.json can
## be checked without more I/O. Anything no rule recognises is KEEP.

use model

DAY_MS := 86400000

pub struct Rule
    pub id str
    pub kind str
    pub pattern str
    pub needs str
    pub min_age_days int
    pub under str
    pub expand bool
    pub rating model.Rating
    pub confidence int
    pub reason str
    pub regrows bool

## kind "prefix": a directory at this home-relative path (expand: each direct child instead).
## kind "name": a directory with this name, next to the file `needs` ("" for none).
## kind "ext": a file with one of these extensions ("dmg|pkg"), older than
## min_age_days, below the home-relative `under` ("" for anywhere).
fn rule(
    id str,
    kind str,
    pattern str,
    needs str,
    min_age_days int,
    under str,
    expand bool,
    rating model.Rating,
    confidence int,
    reason str,
    regrows bool,
) Rule
    Rule(
        id: id,
        kind: kind,
        pattern: pattern,
        needs: needs,
        min_age_days: min_age_days,
        under: under,
        expand: expand,
        rating: rating,
        confidence: confidence,
        reason: reason,
        regrows: regrows,
    )

fn dir_rule(id str, pattern str, expand bool, rating model.Rating, confidence int, reason str) Rule
    rule(id, "prefix", pattern, "", 0, "", expand, rating, confidence, reason, true)

fn name_rule(id str, name str, needs str, rating model.Rating, confidence int, reason str) Rule
    rule(id, "name", name, needs, 0, "", false, rating, confidence, reason, true)

fn ext_rule(
    id str,
    exts str,
    age int,
    under str,
    rating model.Rating,
    confidence int,
    reason str,
) Rule
    rule(id, "ext", exts, "", age, under, false, rating, confidence, reason, false)

## kind "abs": a directory at this absolute path (expand: each direct child
## instead). Unlike the home-relative kinds it applies under /Library and the
## other system folders `is_protected` keeps rated KEEP, because macOS puts
## downloaded wallpapers, simulator runtimes and sound libraries there.
fn abs_rule(id str, pattern str, expand bool, rating model.Rating, confidence int, reason str) Rule
    rule(id, "abs", pattern, "", 0, "", expand, rating, confidence, reason, true)

## Rules for things only a Mac has: Xcode and simulators, wallpapers, installers.
fn macos_rules() List[Rule]
    safe := model.Rating.Safe
    prob := model.Rating.Probably
    [
        dir_rule(
            "sim.device",
            "Library/Developer/CoreSimulator/Devices",
            true,
            prob,
            65,
            "one iOS simulator: its apps and test data; delete it with xcrun simctl delete if you no longer test on it",
        ),
        abs_rule(
            "sim.runtime.vol",
            "/Library/Developer/CoreSimulator/Volumes",
            true,
            prob,
            80,
            "an iOS, watchOS, tvOS or visionOS simulator runtime; Xcode > Settings > Platforms downloads it again",
        ),
        abs_rule(
            "sim.runtime.img",
            "/Library/Developer/CoreSimulator/Images",
            true,
            prob,
            80,
            "a simulator runtime disk image; Xcode downloads it again",
        ),
        abs_rule(
            "sim.runtime.old",
            "/Library/Developer/CoreSimulator/Profiles/Runtimes",
            true,
            prob,
            80,
            "an installed simulator runtime; Xcode downloads it again",
        ),
        abs_rule(
            "sim.runtime.cryptex",
            "/Library/Developer/CoreSimulator/Cryptex",
            true,
            prob,
            75,
            "simulator runtime support files",
        ),
        dir_rule(
            "xcode.devsupport.each",
            "Library/Developer/Xcode/iOS DeviceSupport",
            true,
            prob,
            85,
            "debug symbols for one iOS version; copied again when a device of that version connects",
        ),
        dir_rule(
            "xcode.devsupport.watch",
            "Library/Developer/Xcode/watchOS DeviceSupport",
            false,
            prob,
            85,
            "debug symbols for Apple Watch; copied again when a watch connects",
        ),
        dir_rule(
            "xcode.devsupport.tv",
            "Library/Developer/Xcode/tvOS DeviceSupport",
            false,
            prob,
            85,
            "debug symbols for Apple TV; copied again when one connects",
        ),
        dir_rule(
            "xcode.devsupport.vision",
            "Library/Developer/Xcode/visionOS DeviceSupport",
            false,
            prob,
            85,
            "debug symbols for Apple Vision Pro; copied again when one connects",
        ),
        dir_rule(
            "xcode.products",
            "Library/Developer/Xcode/Products",
            false,
            prob,
            70,
            "built products Xcode keeps for archives; rebuilt on the next archive",
        ),
        dir_rule(
            "xcode.docs",
            "Library/Developer/Xcode/DocumentationCache",
            false,
            safe,
            90,
            "Xcode's documentation cache; rebuilt when you open the docs",
        ),
        dir_rule(
            "xcode.previews",
            "Library/Developer/Xcode/UserData/Previews",
            false,
            safe,
            90,
            "SwiftUI preview data; rebuilt when a preview runs",
        ),
        dir_rule(
            "xcode.cache",
            "Library/Caches/com.apple.dt.Xcode",
            false,
            safe,
            90,
            "Xcode's cache; rebuilt on demand",
        ),
        dir_rule(
            "xcpg",
            "Library/Developer/XCPGDevices",
            false,
            safe,
            85,
            "Xcode Playground simulator devices; recreated when needed",
        ),
        abs_rule(
            "wallpaper.idle",
            "/Library/Application Support/com.apple.idleassetsd",
            false,
            prob,
            80,
            "downloaded Aerial screensaver and wallpaper videos; macOS downloads them again if you pick them",
        ),
        dir_rule(
            "wallpaper.user",
            "Library/Application Support/com.apple.wallpaper/aerials",
            false,
            prob,
            80,
            "downloaded Aerial wallpaper videos; macOS downloads them again if you pick them",
        ),
        abs_rule(
            "wallpaper.desktop",
            "/Library/Desktop Pictures",
            false,
            prob,
            60,
            "extra desktop pictures installed with macOS; the one you use is copied elsewhere",
        ),
        abs_rule(
            "macos.updates",
            "/Library/Updates",
            false,
            prob,
            85,
            "downloaded macOS updates; macOS fetches them again",
        ),
        abs_rule(
            "macos.installdata",
            "/macOS Install Data",
            false,
            prob,
            85,
            "left over from a macOS upgrade; safe once the upgrade finished",
        ),
        abs_rule(
            "garageband",
            "/Library/Application Support/GarageBand",
            false,
            prob,
            60,
            "GarageBand sound library; download it again from inside GarageBand",
        ),
        abs_rule(
            "logic",
            "/Library/Application Support/Logic",
            false,
            prob,
            60,
            "Logic Pro sound library; download it again from inside Logic",
        ),
        abs_rule(
            "loops",
            "/Library/Audio/Apple Loops",
            false,
            prob,
            60,
            "Apple Loops; GarageBand and Logic download them again",
        ),
        dir_rule(
            "mail.downloads",
            "Library/Containers/com.apple.mail/Data/Library/Mail Downloads",
            false,
            prob,
            70,
            "copies of mail attachments you opened; the originals stay in Mail",
        ),
        dir_rule("android.avd", ".android/avd", true, prob, 70, "one Android emulator device: its disk image and apps; recreate it in Android Studio's Device Manager"),
        dir_rule("android.cache", ".android/cache", false, safe, 90, "Android tools' download cache"),
        dir_rule("android.images", "Library/Android/sdk/system-images", true, prob, 80, "an Android emulator system image; sdkmanager downloads it again"),
        dir_rule("android.platforms", "Library/Android/sdk/platforms", true, prob, 70, "an Android SDK platform; downloaded again when a project needs it"),
        dir_rule("android.buildtools", "Library/Android/sdk/build-tools", true, prob, 75, "Android build tools; Gradle downloads the version a project asks for"),
        dir_rule("android.ndk", "Library/Android/sdk/ndk", true, prob, 70, "an Android NDK version; downloaded again when a project needs it"),
        dir_rule("android.sources", "Library/Android/sdk/sources", false, safe, 85, "Android framework sources for the debugger; sdkmanager downloads them again"),
        dir_rule("android.intermediates", "Library/Android/sdk/.downloadIntermediates", false, safe, 95, "leftover SDK download pieces"),
        dir_rule(
            "vscode.cache",
            "Library/Application Support/Code/CachedData",
            false,
            safe,
            90,
            "VS Code's compiled-code cache; rebuilt on launch",
        ),
        dir_rule(
            "vscode.vsix",
            "Library/Application Support/Code/CachedExtensionVSIXs",
            false,
            safe,
            90,
            "downloaded extension packages; fetched again on update",
        ),
    ]

fn base_rules() List[Rule]
    safe := model.Rating.Safe
    prob := model.Rating.Probably
    keep := model.Rating.Keep
    [
        name_rule(
            "xcode.derived",
            "DerivedData",
            "",
            safe,
            95,
            "Xcode build output; Xcode rebuilds it",
        ),
        dir_rule(
            "xcode.derived2",
            "Library/Developer/Xcode/DerivedData",
            false,
            safe,
            95,
            "Xcode build output; Xcode rebuilds it",
        ),
        dir_rule(
            "xcode.devsupport",
            "Library/Developer/Xcode/iOS DeviceSupport",
            false,
            prob,
            85,
            "debug symbols; re-copied from a device when you plug it in",
        ),
        dir_rule(
            "xcode.archives",
            "Library/Developer/Xcode/Archives",
            false,
            keep,
            70,
            "archived app builds; needed to symbolicate crashes and re-submit",
        ),
        dir_rule(
            "sim.caches",
            "Library/Developer/CoreSimulator/Caches",
            false,
            safe,
            90,
            "simulator caches; rebuilt on launch",
        ),
        dir_rule(
            "sim.devices",
            "Library/Developer/CoreSimulator/Devices",
            false,
            prob,
            60,
            "simulator disks hold test app data; prefer xcrun simctl delete unavailable",
        ),
        dir_rule(
            "brew.cache",
            "Library/Caches/Homebrew",
            false,
            safe,
            95,
            "downloaded bottles; brew cleanup removes them",
        ),
        dir_rule("pip.cache", "Library/Caches/pip", false, safe, 95, "pip download cache"),
        dir_rule(
            "lib.caches",
            "Library/Caches",
            true,
            prob,
            85,
            "per-app cache; the app rebuilds it, maybe slowly once",
        ),
        dir_rule(
            "lib.logs",
            "Library/Logs",
            false,
            safe,
            85,
            "old logs; only useful for debugging past problems",
        ),
        dir_rule("npm.cache", ".npm/_cacache", false, safe, 95, "npm download cache"),
        dir_rule(
            "cargo.cache",
            ".cargo/registry/cache",
            false,
            safe,
            90,
            "downloaded crates; cargo fetches them again",
        ),
        dir_rule(
            "gradle.cache",
            ".gradle/caches",
            false,
            prob,
            85,
            "Gradle caches; rebuilt, with a slow first build",
        ),
        dir_rule(
            "maven.repo",
            ".m2/repository",
            false,
            prob,
            75,
            "Maven artifacts; re-downloaded, but offline builds will fail",
        ),
        dir_rule("dot.cache", ".cache", true, prob, 85, "per-tool cache under ~/.cache"),
        dir_rule(
            "trash",
            ".Trash",
            false,
            prob,
            90,
            "already in the Trash; emptying it is permanent",
        ),
        dir_rule(
            "docker.data",
            "Library/Containers/com.docker.docker",
            false,
            keep,
            80,
            "Docker's disk image holds your images and volumes; use docker system prune",
        ),
        dir_rule(
            "ios.backup",
            "Library/Application Support/MobileSync/Backup",
            false,
            keep,
            70,
            "iPhone backups; may be your only copy",
        ),
        name_rule(
            "node_modules",
            "node_modules",
            "package.json",
            safe,
            90,
            "installed packages; npm install restores them",
        ),
        name_rule("next", ".next", "package.json", safe, 90, "Next.js build output"),
        name_rule(
            "cargo.target",
            "target",
            "Cargo.toml",
            safe,
            90,
            "Rust build output; cargo build recreates it",
        ),
        name_rule("swiftpm", ".build", "Package.swift", safe, 90, "SwiftPM build output"),
        name_rule(
            "pods",
            "Pods",
            "Podfile",
            safe,
            85,
            "CocoaPods checkout; pod install restores it",
        ),
        name_rule("pycache", "__pycache__", "", safe, 95, "compiled Python; regenerated on import"),
        name_rule("pytest", ".pytest_cache", "", safe, 95, "pytest cache"),
        name_rule("mypy", ".mypy_cache", "", safe, 95, "mypy cache"),
        name_rule("tox", ".tox", "", safe, 90, "tox environments"),
        name_rule(
            "venv",
            ".venv",
            "",
            prob,
            75,
            "Python virtual environment; recreate with pip install",
        ),
        name_rule("zigcache", ".zig-cache", "", safe, 90, "Zig build cache"),
        name_rule(
            "js.build",
            "build",
            "package.json",
            prob,
            60,
            "JavaScript build output; rebuild with the project's build script",
        ),
        ext_rule(
            "installer",
            "dmg|pkg|iso|xip",
            30,
            "Downloads",
            prob,
            85,
            "installer older than 30 days; usually downloadable again",
        ),
        ext_rule(
            "old.archive",
            "zip|tar|gz|tgz|7z",
            90,
            "Downloads",
            prob,
            55,
            "archive older than 90 days in Downloads; check what it holds first",
        ),
    ]

pub fn builtin() List[Rule]
    mut all := base_rules()
    all.extend(macos_rules())
    all

## Directories Husk never recommends from (rating KEEP) unless the caller passes
## allow_protected. Home-relative.
fn protected_home() List[str]
    [
        "Documents",
        "Desktop",
        "Pictures",
        "Movies",
        "Music",
        ".ssh",
        ".gnupg",
        "Library/Mobile Documents",
        "Library/Keychains",
        "Library/Messages",
        "Library/Mail",
        "Library/Photos",
        "Library/Application Support/MobileSync",
    ]

fn protected_abs() List[str]
    [
        "/System",
        "/usr",
        "/bin",
        "/sbin",
        "/etc",
        "/private",
        "/Library",
        "/Applications",
        "/opt",
        "/Volumes",
    ]

pub fn relative(p str, home str) str
    h := "{home}/"
    if p.starts_with(h)
        p.slice(h.len(), p.len())
    else
        p

fn within(rel str, dir str) bool
    rel == dir or rel.starts_with("{dir}/")

pub fn is_protected(p str, home str) bool
    rel := relative(p, home)
    if p.contains(".photoslibrary") or p.contains(".musiclibrary")
        return true
    if rel != p
        for d in protected_home()
            if within(rel, d)
                return true
        return false
    for d in protected_abs()
        if within(p, d)
            return true
    false

fn depth(s str) int
    s.count("/")

fn fits(r Rule, p str, rel str, is_dir bool, mtime_ms int, now_ms int, markers Set[str]) bool
    match r.kind
        "prefix" =>
            if not is_dir
                return false
            if r.expand
                depth(rel) == depth(r.pattern) + 1 and rel.starts_with("{r.pattern}/")
            else
                rel == r.pattern
        "name" =>
            if not is_dir or path.base(p) != r.pattern
                return false
            r.needs == "" or markers.contains("{path.dir(p)}/{r.needs}")
        "abs" =>
            if not is_dir
                return false
            if r.expand
                path.dir(p) == r.pattern
            else
                p == r.pattern
        "ext" =>
            if is_dir
                return false
            if r.under != "" and not within(rel, r.under)
                return false
            age := (now_ms - mtime_ms) / DAY_MS
            age >= r.min_age_days and r.pattern.split("|").contains(path.ext(p).to_lower())
        _ => false

## Does an "abs" rule name this path? Those apply even where `is_protected` does.
fn abs_fits(
    rules List[Rule],
    p str,
    rel str,
    is_dir bool,
    mtime_ms int,
    now_ms int,
    markers Set[str],
) bool
    for r in rules
        if r.kind == "abs" and fits(r, p, rel, is_dir, mtime_ms, now_ms, markers)
            return true
    false

fn specificity(r Rule) int
    r.pattern.len()

## The verdict for one path. The most specific matching rule wins (longest pattern).
pub fn rate(
    p str,
    is_dir bool,
    mtime_ms int,
    home str,
    now_ms int,
    markers Set[str],
    rules List[Rule],
    allow_protected bool,
) model.Verdict
    rel := relative(p, home)
    if not allow_protected and is_protected(p, home) and not abs_fits(
        rules,
        p,
        rel,
        is_dir,
        mtime_ms,
        now_ms,
        markers,
    )
        return model.Verdict.keep(
            "protected",
            99,
            "your documents, system or account data; pass allow_protected to let rules apply here",
            true,
        )
    mut best := -1
    for i in 0..rules.len()
        if fits(rules[i], p, rel, is_dir, mtime_ms, now_ms, markers)
            if best < 0 or specificity(rules[i]) > specificity(rules[best])
                best = i
    if best < 0
        return model.Verdict.keep(
            "none",
            40,
            "no rule recognises this; Husk only recommends what it understands",
            false,
        )
    r := rules[best]
    model.Verdict(
        rating: r.rating,
        confidence: r.confidence,
        rule: r.id,
        reason: r.reason,
        regrows: r.regrows,
        protected: false,
    )

fn rated(p str, is_dir bool, age_days int, markers List[str]) model.Verdict
    mut known := Set[str]()
    for m in markers
        known.add(m)
    rate(
        p,
        is_dir,
        1000000000000 - age_days * DAY_MS,
        "/Users/u",
        1000000000000,
        known,
        builtin(),
        false,
    )

@test fn caches_are_probably_safe_but_homebrew_is_safe()
    assert_eq(rated("/Users/u/Library/Caches/com.foo", true, 0, []).rule, "lib.caches")
    assert_eq(rated("/Users/u/Library/Caches/Homebrew", true, 0, []).rule, "brew.cache")
    assert_eq(rated("/Users/u/Library/Caches/com.foo/deep", true, 0, []).rule, "none")

@test fn node_modules_needs_its_package_json()
    assert_eq(rated("/Users/u/code/app/node_modules", true, 0, []).rule, "none")
    v := rated("/Users/u/code/app/node_modules", true, 0, ["/Users/u/code/app/package.json"])
    assert_eq(v.rule, "node_modules")
    assert_eq(v.rating.name(), "SAFE")

@test fn documents_are_protected()
    v := rated(
        "/Users/u/Documents/app/node_modules",
        true,
        0,
        ["/Users/u/Documents/app/package.json"],
    )
    assert(v.protected)
    assert_eq(v.rating.name(), "KEEP")
    assert(rules_protected_system())

fn rules_protected_system() bool
    is_protected("/System/Library/x", "/Users/u") and not is_protected("/Users/u/code", "/Users/u")

@test fn old_installers_in_downloads()
    assert_eq(rated("/Users/u/Downloads/x.dmg", false, 45, []).rule, "installer")
    assert_eq(rated("/Users/u/Downloads/x.dmg", false, 3, []).rule, "none")
    assert_eq(rated("/Users/u/Desktop/x.dmg", false, 45, []).rule, "protected")

@test fn simulator_runtimes_and_wallpapers_are_found_under_library()
    v := rated("/Library/Developer/CoreSimulator/Volumes/iOS_22A3351", true, 0, [])
    assert_eq(v.rule, "sim.runtime.vol")
    assert(not v.protected)
    assert_eq(
        rated("/Library/Application Support/com.apple.idleassetsd", true, 0, []).rule,
        "wallpaper.idle",
    )
    assert_eq(rated("/Library/Application Support/Other", true, 0, []).rule, "protected")
    assert_eq(
        rated("/Users/u/Library/Developer/CoreSimulator/Devices/ABC", true, 0, []).rule,
        "sim.device",
    )
    assert_eq(
        rated("/Users/u/Library/Developer/Xcode/iOS DeviceSupport/17.0", true, 0, []).rule,
        "xcode.devsupport.each",
    )
